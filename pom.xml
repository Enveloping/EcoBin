<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>org.enveloping</groupId>
    <artifactId>EcoBin</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>EcoBin</name>
    <description>EcoBin - 垃圾回收管理系统</description>

    <modules>
        <module>ecobin-framework</module>
        <module>ecobin-module-identity</module>
        <module>ecobin-module-device</module>
        <module>ecobin-module-funds</module>
        <module>ecobin-module-recycling</module>
        <module>ecobin-module-operations</module>
        <module>ecobin-integration</module>
        <module>ecobin-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <pulsar.version>4.1.3</pulsar.version>
        <jjwt.version>0.12.6</jjwt.version>
        <datasource-proxy.version>1.11.0</datasource-proxy.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>org.enveloping</groupId>
                <artifactId>ecobin-framework</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.enveloping</groupId>
                <artifactId>ecobin-module-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.enveloping</groupId>
                <artifactId>ecobin-module-device</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.enveloping</groupId>
                <artifactId>ecobin-module-funds</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.enveloping</groupId>
                <artifactId>ecobin-module-recycling</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.enveloping</groupId>
                <artifactId>ecobin-module-operations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.enveloping</groupId>
                <artifactId>ecobin-integration</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 腾讯云 COS STS（临时密钥） -->
            <dependency>
                <groupId>com.qcloud</groupId>
                <artifactId>cos-sts_api</artifactId>
                <version>3.1.1</version>
            </dependency>

            <!-- 中国移动 OneNet 北向消息队列（Pulsar 客户端，版本对齐官方 SDK demo/平台 broker） -->
            <dependency>
                <groupId>org.apache.pulsar</groupId>
                <artifactId>pulsar-client</artifactId>
                <version>${pulsar.version}</version>
            </dependency>

            <!-- 本地诊断模式的 JDBC 执行观察器；不改写 SQL 或参数。 -->
            <dependency>
                <groupId>net.ttddyy</groupId>
                <artifactId>datasource-proxy</artifactId>
                <version>${datasource-proxy.version}</version>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
