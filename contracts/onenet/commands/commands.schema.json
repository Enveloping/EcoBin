{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecobin.local/contracts/onenet/commands/commands.schema.json",
  "title": "EcoBin OneNet P0 typed commands and controls",
  "oneOf": [
    { "$ref": "#/$defs/applyConfigurationCommand" },
    { "$ref": "#/$defs/startDeliverySessionCommand" },
    { "$ref": "#/$defs/quarantineDeliveryRecoveryCommand" },
    { "$ref": "#/$defs/startCleanOperationCommand" },
    { "$ref": "#/$defs/endCleanBeforeUnlockCommand" },
    { "$ref": "#/$defs/resumeCleanOperationCommand" },
    { "$ref": "#/$defs/sampleFullnessCommand" },
    { "$ref": "#/$defs/measureEmptyBagBaselineCommand" },
    { "$ref": "#/$defs/confirmEdgeEventCommand" },
    { "$ref": "#/$defs/providePhotoUploadGrantCommand" },
    { "$ref": "#/$defs/requestDeviceAcceptanceCommand" },
    { "$ref": "#/$defs/authorizeFactorySealCommand" },
    { "$ref": "#/$defs/syncDeviceEntryUrlCommand" },
    { "$ref": "#/$defs/startMcuFirmwareUpdateCommand" },
    { "$ref": "#/$defs/startBusinessRuntimeUpdateCommand" },
    { "$ref": "#/$defs/cancelBusinessRuntimeUpdateCommand" },
    { "$ref": "#/$defs/openRemoteSupportTunnelCommand" },
    { "$ref": "#/$defs/closeRemoteSupportTunnelCommand" }
  ],
  "$defs": {
    "configIdentity": {
      "type": "object",
      "required": [
        "version",
        "contentSha256",
        "mcuPayloadSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contentSha256": {
          "$ref": "../common.schema.json#/$defs/sha256"
        },
        "mcuPayloadSha256": {
          "$ref": "../common.schema.json#/$defs/sha256"
        }
      }
    },
    "deviceConfig": {
      "type": "object",
      "required": [
        "continueDeliveryWaitMs",
        "negativeWeightThresholdGrams",
        "deliveryAutoCloseMs",
        "weightMeasurementTimeoutMs",
        "deliveryDoorTravelWaitMs",
        "cleanSolenoidPulseMs",
        "smokeMonitoringEnabled"
      ],
      "additionalProperties": false,
      "properties": {
        "edgeHeartbeatIntervalMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "edgeHeartbeatMissThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "continueDeliveryWaitMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 4294967295
        },
        "negativeWeightThresholdGrams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "deliveryAutoCloseMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        },
        "weightMeasurementTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 6000
        },
        "deliveryDoorTravelWaitMs": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 45000
        },
        "cleanSolenoidPulseMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "smokeMonitoringEnabled": {
          "type": "boolean"
        }
      }
    },
    "portConfig": {
      "type": "object",
      "required": [
        "portNo",
        "displayName",
        "enabled",
        "unitPriceTenThousandths",
        "fullnessMode",
        "configuredFullWeightGrams",
        "fullnessSettleWaitMs",
        "fullnessSensorKind",
        "fullnessDistanceThresholdMm",
        "fullnessSampleCount",
        "fullnessMinimumValidSampleCount",
        "fullnessEchoTimeoutUs",
        "weightStableWindowMs",
        "weightMaximumFluctuationGrams",
        "weightRequiredSampleCount",
        "weightMeasurementTimeoutMs",
        "weightMinimumGrams",
        "weightMaximumGrams",
        "calibrationVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "portNo": {
          "$ref": "../common.schema.json#/$defs/portNo"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "enabled": {
          "type": "boolean"
        },
        "unitPriceTenThousandths": {
          "$ref": "../common.schema.json#/$defs/unitPriceTenThousandths"
        },
        "fullnessMode": {
          "enum": ["SENSOR_ONLY", "WEIGHT_ONLY", "SENSOR_OR_WEIGHT"]
        },
        "configuredFullWeightGrams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "fullnessSettleWaitMs": {
          "$ref": "../common.schema.json#/$defs/durationMs"
        },
        "fullnessSensorKind": {
          "enum": ["ULTRASONIC", "DIGITAL_INFRARED"]
        },
        "fullnessDistanceThresholdMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "fullnessSampleCount": {
          "type": "integer",
          "minimum": 3,
          "maximum": 9
        },
        "fullnessMinimumValidSampleCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "fullnessEchoTimeoutUs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 100000
        },
        "weightStableWindowMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000
        },
        "weightMaximumFluctuationGrams": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "weightRequiredSampleCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "weightMeasurementTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 6000
        },
        "weightMinimumGrams": {
          "$ref": "../common.schema.json#/$defs/signedInt32Grams"
        },
        "weightMaximumGrams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "calibrationVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "applyConfigurationPayload": {
      "type": "object",
      "required": [
        "applicationUid",
        "config",
        "deviceConfig",
        "ports"
      ],
      "additionalProperties": false,
      "properties": {
        "applicationUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "config": {
          "$ref": "#/$defs/configIdentity"
        },
        "deviceConfig": {
          "$ref": "#/$defs/deviceConfig"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/portConfig"
          }
        }
      }
    },
    "startDeliverySessionPayload": {
      "type": "object",
      "required": [
        "sessionUid",
        "portNo",
        "bagUid",
        "config",
        "unitPriceTenThousandths",
        "continueDeliveryWaitMs",
        "negativeWeightThresholdGrams",
        "deliveryAutoCloseMs"
      ],
      "additionalProperties": false,
      "properties": {
        "sessionUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "portNo": {
          "$ref": "../common.schema.json#/$defs/portNo"
        },
        "bagUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "config": {
          "$ref": "#/$defs/configIdentity"
        },
        "unitPriceTenThousandths": {
          "$ref": "../common.schema.json#/$defs/unitPriceTenThousandths"
        },
        "continueDeliveryWaitMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 4294967295
        },
        "negativeWeightThresholdGrams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "deliveryAutoCloseMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 4294967295
        }
      }
    },
    "quarantineDeliveryRecoveryPayload": {
      "type": "object",
      "required": [
        "recoveryUid",
        "sessionUid",
        "originalCommandUid",
        "physicalOutcomeUnknownConfirmed",
        "causeFixedConfirmed",
        "devicePowerCycledConfirmed",
        "motionAreaClearConfirmed",
        "deliveryDoorClosedConfirmed",
        "mechanismClearConfirmed",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "recoveryUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "sessionUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "originalCommandUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "physicalOutcomeUnknownConfirmed": { "const": true },
        "causeFixedConfirmed": { "const": true },
        "devicePowerCycledConfirmed": { "const": true },
        "motionAreaClearConfirmed": { "const": true },
        "deliveryDoorClosedConfirmed": { "const": true },
        "mechanismClearConfirmed": { "const": true },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "startCleanOperationPayload": {
      "type": "object",
      "required": [
        "operationUid",
        "portNo",
        "oldBagUid",
        "oldBaselineWeightGrams",
        "newBagUid",
        "config",
        "operationWindowMs",
        "recoveryGeneration"
      ],
      "additionalProperties": false,
      "properties": {
        "operationUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "portNo": {
          "$ref": "../common.schema.json#/$defs/portNo"
        },
        "oldBagUid": {
          "oneOf": [
            { "$ref": "../common.schema.json#/$defs/uuid" },
            { "type": "null" }
          ]
        },
        "oldBaselineWeightGrams": {
          "$ref": "../common.schema.json#/$defs/nullableSignedInt32Grams"
        },
        "newBagUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "config": {
          "$ref": "#/$defs/configIdentity"
        },
        "operationWindowMs": {
          "$ref": "../common.schema.json#/$defs/positiveDurationMs"
        },
        "recoveryGeneration": {
          "const": 0
        }
      }
    },
    "endCleanBeforeUnlockPayload": {
      "type": "object",
      "required": [
        "operationUid",
        "portNo",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "operationUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "portNo": {
          "$ref": "../common.schema.json#/$defs/portNo"
        },
        "reason": {
          "enum": [
            "CLEANER_CANCELLED",
            "START_AUTHORIZATION_EXPIRED",
            "PREUNLOCK_FAILURE"
          ]
        }
      }
    },
    "resumeCleanOperationPayload": {
      "type": "object",
      "required": [
        "operationUid",
        "portNo",
        "newBagUid",
        "config",
        "operationWindowMs",
        "recoveryGeneration",
        "originalCleanerConfirmedOnsite"
      ],
      "additionalProperties": false,
      "properties": {
        "operationUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "portNo": {
          "$ref": "../common.schema.json#/$defs/portNo"
        },
        "newBagUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "config": {
          "$ref": "#/$defs/configIdentity"
        },
        "operationWindowMs": {
          "$ref": "../common.schema.json#/$defs/positiveDurationMs"
        },
        "recoveryGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "originalCleanerConfirmedOnsite": {
          "const": true
        }
      }
    },
    "sampleFullnessPayload": {
      "type": "object",
      "required": [
        "detectionUid",
        "portNo",
        "sampleRole",
        "triggerType",
        "fullnessMode",
        "currentBaselineWeightGrams",
        "configuredFullWeightGrams",
        "settleWaitMs",
        "measurementTimeoutMs",
        "config"
      ],
      "additionalProperties": false,
      "properties": {
        "detectionUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "portNo": {
          "$ref": "../common.schema.json#/$defs/portNo"
        },
        "sampleRole": {
          "enum": ["INITIAL", "CONFIRMATION", "MANUAL_RECHECK"]
        },
        "triggerType": {
          "enum": ["DELIVERY_COMPLETE", "CLEAN_COMPLETE", "MANUAL_RECHECK"]
        },
        "fullnessMode": {
          "enum": ["SENSOR_ONLY", "WEIGHT_ONLY", "SENSOR_OR_WEIGHT"]
        },
        "currentBaselineWeightGrams": {
          "$ref": "../common.schema.json#/$defs/nullableSignedInt32Grams"
        },
        "configuredFullWeightGrams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "settleWaitMs": {
          "$ref": "../common.schema.json#/$defs/durationMs"
        },
        "measurementTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 6000
        },
        "config": {
          "$ref": "#/$defs/configIdentity"
        }
      }
    },
    "measureEmptyBagBaselinePayload": {
      "type": "object",
      "required": [
        "measurementUid",
        "portNo",
        "bagUid",
        "emptyBagConfirmed",
        "measurementTimeoutMs",
        "config"
      ],
      "additionalProperties": false,
      "properties": {
        "measurementUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "portNo": {
          "$ref": "../common.schema.json#/$defs/portNo"
        },
        "bagUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "emptyBagConfirmed": {
          "const": true
        },
        "measurementTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 6000
        },
        "config": {
          "$ref": "#/$defs/configIdentity"
        }
      }
    },
    "confirmEdgeEventPayload": {
      "type": "object",
      "required": [
        "confirmationUid",
        "originalEventUid",
        "originalPayloadSha256",
        "outcome",
        "effectKind",
        "processedAt",
        "resultReferences",
        "errorCode",
        "quarantineUid"
      ],
      "additionalProperties": false,
      "properties": {
        "confirmationUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "originalEventUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "originalPayloadSha256": {
          "$ref": "../common.schema.json#/$defs/sha256"
        },
        "outcome": {
          "enum": ["BUSINESS_APPLIED", "EVENT_QUARANTINED"]
        },
        "effectKind": {
          "type": ["string", "null"],
          "enum": ["CREATED", "UPDATED", "NO_ACTION_REQUIRED", null]
        },
        "processedAt": {
          "$ref": "../common.schema.json#/$defs/utcInstant"
        },
        "resultReferences": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "../common.schema.json#/$defs/resultReference"
          }
        },
        "errorCode": {
          "$ref": "../common.schema.json#/$defs/errorCode"
        },
        "quarantineUid": {
          "oneOf": [
            { "$ref": "../common.schema.json#/$defs/uuid" },
            { "type": "null" }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "outcome": { "const": "BUSINESS_APPLIED" },
            "effectKind": {
              "enum": ["CREATED", "UPDATED", "NO_ACTION_REQUIRED"]
            },
            "errorCode": { "type": "null" },
            "quarantineUid": { "type": "null" }
          }
        },
        {
          "properties": {
            "outcome": { "const": "EVENT_QUARANTINED" },
            "effectKind": { "type": "null" },
            "resultReferences": {
              "type": "array",
              "maxItems": 0
            },
            "errorCode": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "maxLength": 64
            },
            "quarantineUid": {
              "oneOf": [
                { "$ref": "../common.schema.json#/$defs/uuid" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "providePhotoUploadGrantPayload": {
      "type": "object",
      "required": [
        "grantRequestEventUid",
        "workType",
        "workUid",
        "authorizedSlots"
      ],
      "additionalProperties": false,
      "properties": {
        "grantRequestEventUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "workType": {
          "enum": ["DELIVERY_SESSION", "CLEAN_OPERATION"]
        },
        "workUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "authorizedSlots": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "BEFORE_INNER",
              "BEFORE_OUTER",
              "AFTER_INNER",
              "AFTER_OUTER",
              "FIRST_OPEN_INNER",
              "FIRST_OPEN_OUTER",
              "FINAL_CLOSE_INNER",
              "FINAL_CLOSE_OUTER"
            ]
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "workType": { "const": "DELIVERY_SESSION" },
            "authorizedSlots": {
              "items": {
                "enum": [
                  "BEFORE_INNER",
                  "BEFORE_OUTER",
                  "AFTER_INNER",
                  "AFTER_OUTER"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "workType": { "const": "CLEAN_OPERATION" },
            "authorizedSlots": {
              "items": {
                "enum": [
                  "FIRST_OPEN_INNER",
                  "FIRST_OPEN_OUTER",
                  "FINAL_CLOSE_INNER",
                  "FINAL_CLOSE_OUTER"
                ]
              }
            }
          }
        }
      ]
    },
    "requestDeviceAcceptancePayload": {
      "type": "object",
      "required": [
        "challengeUid",
        "expectedPortCount",
        "factoryBagRevision",
        "factoryBagSetSha256",
        "deviceEntryUrl",
        "deviceEntryUrlSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "challengeUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "expectedPortCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "factoryBagRevision": {
          "type": "integer",
          "minimum": 0
        },
        "factoryBagSetSha256": {
          "$ref": "../common.schema.json#/$defs/sha256"
        },
        "deviceEntryUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^https://[\\x21-\\x7e]+$"
        },
        "deviceEntryUrlSha256": {
          "$ref": "../common.schema.json#/$defs/sha256"
        }
      }
    },
    "authorizeFactorySealPayload": {
      "type": "object",
      "required": [
        "sealAuthorizationSchemaVersion",
        "hardwareSn",
        "acceptanceGeneration",
        "acceptanceEvidenceUid",
        "acceptanceChallengeUid",
        "acceptanceEvidenceSha256",
        "factoryBagRevision",
        "factoryBagSetSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "sealAuthorizationSchemaVersion": { "const": 1 },
        "hardwareSn": {
          "$ref": "../common.schema.json#/$defs/deviceName"
        },
        "acceptanceGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "acceptanceEvidenceUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "acceptanceChallengeUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "acceptanceEvidenceSha256": {
          "$ref": "../common.schema.json#/$defs/sha256"
        },
        "factoryBagRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "factoryBagSetSha256": {
          "$ref": "../common.schema.json#/$defs/sha256"
        }
      }
    },
    "syncDeviceEntryUrlPayload": {
      "type": "object",
      "required": [
        "deviceEntryUrl",
        "deviceEntryUrlSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "deviceEntryUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^https://[\\x21-\\x7e]+$"
        },
        "deviceEntryUrlSha256": {
          "$ref": "../common.schema.json#/$defs/sha256"
        }
      }
    },
    "startMcuFirmwareUpdatePayload": {
      "type": "object",
      "required": [
        "deploymentUid",
        "releaseUid",
        "firmwareVersion",
        "firmwareVersionCode",
        "firmwareIdentityHex",
        "objectKey",
        "packageSha256",
        "packageSize",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "deploymentUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "releaseUid": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "firmwareVersion": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "firmwareVersionCode": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "firmwareIdentityHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "objectKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^ecobin/mcu-firmware/[0-9a-f-]{36}/[0-9a-f]{64}\\.efw$"
        },
        "packageSha256": {
          "$ref": "../common.schema.json#/$defs/sha256"
        },
        "packageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            { "type": "null" }
          ]
        }
      }
    },
    "startBusinessRuntimeUpdatePayload": {
      "type": "object",
      "required": [
        "deploymentUid",
        "updateUid",
        "controlSequence",
        "releaseUid",
        "versionName",
        "releaseSequence",
        "objectKey",
        "packageSha256",
        "packageSize",
        "packageSignatureBase64",
        "signatureSha256",
        "signingKeyId",
        "observationWindowSeconds",
        "downloadTimeoutSeconds",
        "drainTimeoutSeconds",
        "maximumRetryCount",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "deploymentUid": { "$ref": "../common.schema.json#/$defs/uuid" },
        "updateUid": { "$ref": "../common.schema.json#/$defs/uuid" },
        "controlSequence": { "$ref": "../common.schema.json#/$defs/positiveSequence" },
        "releaseUid": { "$ref": "../common.schema.json#/$defs/uuid" },
        "versionName": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "releaseSequence": { "$ref": "../common.schema.json#/$defs/positiveSequence" },
        "objectKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^edge-runtime/releases/[0-9a-f-]{36}/package\\.tar\\.gz$"
        },
        "packageSha256": { "$ref": "../common.schema.json#/$defs/sha256" },
        "packageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1500000000
        },
        "packageSignatureBase64": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        },
        "signatureSha256": { "$ref": "../common.schema.json#/$defs/sha256" },
        "signingKeyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "observationWindowSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "downloadTimeoutSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "drainTimeoutSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "maximumRetryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
