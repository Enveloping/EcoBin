[Unit]
Description=EcoBin permanent device updater stage-four candidate
ConditionPathExists=!/var/lib/ecobin/device-management-maintenance/runtime-start-blocked.json
Requires=ecobin-mcu-safe-gpio.service
Wants=ecobin-business-activation-candidate-helper.socket ecobin-mcu-flash-candidate-helper.socket
After=local-fs.target ecobin-mcu-safe-gpio.service
Conflicts=ecobin-updater.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=ecobin-updater
Group=ecobin-updater-ipc
SupplementaryGroups=ecobin-communication-ipc ecobin-business-ipc ecobin-privileged-helper-ipc
WorkingDirectory=/opt/ecobin/updater/current/app
EnvironmentFile=/usr/share/ecobin/device-management-release.env
ExecStart=/opt/ecobin/updater/current/.venv/bin/python /opt/ecobin/updater/current/app/updater_agent.py --enable-stage4-candidate --enable-mcu-update-candidate --state /var/lib/ecobin/updater/updater.db --mcu-update-state /var/lib/ecobin/updater/mcu-updates.db --mcu-firmware-root /var/lib/ecobin/updater/mcu-firmware --mcu-signing-keys /usr/share/ecobin/mcu-release-keys --mcu-hardware-compatibility ECOBIN_MAINBOARD_V1.1 --socket /run/ecobin/updater/control.sock --socket-group ecobin-updater-ipc --release-version ${ECOBIN_DEVICE_UPDATER_VERSION} --allowed-uid 0 --allowed-user ecobin-communication --allowed-user ecobin-business
Restart=always
RestartSec=2
TimeoutStartSec=30
KillSignal=SIGTERM
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0007
LimitCORE=0
RuntimeDirectory=ecobin/updater
RuntimeDirectoryMode=0750
StateDirectory=ecobin/updater
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
DevicePolicy=closed
InaccessiblePaths=-/etc/ecobin
InaccessiblePaths=-/var/lib/ecobin/business
InaccessiblePaths=-/var/lib/ecobin/communication
ReadOnlyPaths=-/run/ecobin/business
ReadOnlyPaths=-/run/ecobin/communication
ReadOnlyPaths=/usr/share/ecobin/runtime-release-keys
ReadOnlyPaths=/usr/share/ecobin/mcu-release-keys
