# EcoBin Air780E RNDIS batch facts (P5 schema v2)
#
# This template is intentionally HIL-locked. A release engineer sets the two
# public probe targets and HIL_APPROVED=true only after the current Air780E
# carrier board has proved one unambiguous USB-parented rndis_host interface,
# DHCP route, DNS, and HTTPS. USB VID/PID are observed diagnostics, not
# configuration or admission values, so capable procurement batches do not
# require per-device edits.
ECOBIN_CELLULAR_SCHEMA_VERSION=2
ECOBIN_CELLULAR_HIL_APPROVED=false
ECOBIN_CELLULAR_CONNECTION_ID=ecobin-air780e-rndis
ECOBIN_CELLULAR_USB_DRIVER=rndis_host
ECOBIN_CELLULAR_USB_PROFILE=RNDIS
ECOBIN_CELLULAR_AUTO_APN=true
ECOBIN_CELLULAR_PROBE_IPV4=HIL_REQUIRED
ECOBIN_CELLULAR_HTTPS_PROBE_URL=https://HIL_REQUIRED/
