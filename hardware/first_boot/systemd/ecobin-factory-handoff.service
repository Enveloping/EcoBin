[Unit]
Description=EcoBin factory UART handoff (P7 gate)
Requires=ecobin-first-boot.service ecobin-mcu-safe-gpio.service
After=ecobin-first-boot.service ecobin-mcu-safe-gpio.service ecobin-enrollment.service
Conflicts=ecobin-factory-test.service ecobin-hardware.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/ecobin/factory-test/current/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/ecobin/hardware.env
ExecCondition=/opt/ecobin/factory-test/current/.venv/bin/python -m first_boot.gate --require handoff
ExecStart=/opt/ecobin/factory-test/current/.venv/bin/python -m factory.acceptance_handoff
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
DevicePolicy=closed
DeviceAllow=/dev/ttyS5 rw
DeviceAllow=/dev/gpiomem rw
DeviceAllow=/dev/mem rw
ReadWritePaths=/var/lib/ecobin/first-boot
ReadWritePaths=/run/lock/ecobin
InaccessiblePaths=-/etc/ecobin/enrollment.key
InaccessiblePaths=-/etc/ecobin/setup-ap.key
InaccessiblePaths=-/etc/ecobin/device-credentials.json
InaccessiblePaths=-/etc/ecobin/remote-support-credentials.json
InaccessiblePaths=-/var/lib/ecobin/hardware
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
