[Unit]
Description=EcoBin immutable runtime fact gate
Requires=ecobin-first-boot.service
After=ecobin-first-boot.service ecobin-factory-handoff.service
Conflicts=ecobin-factory-test.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/ecobin/factory-test/current/.venv/bin/python -m first_boot.gate --require runtime
RemainAfterExit=yes
UMask=0077
