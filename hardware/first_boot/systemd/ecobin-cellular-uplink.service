[Unit]
Description=EcoBin locked Air780E RNDIS uplink coordinator
Requires=ecobin-first-boot.service ecobin-mcu-safe-gpio.service ecobin-factory-egress-lock.service
After=ecobin-first-boot.service ecobin-mcu-safe-gpio.service ecobin-factory-egress-lock.service NetworkManager.service
Conflicts=ecobin-factory-test.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/ecobin/factory-test/current/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecCondition=/opt/ecobin/factory-test/current/.venv/bin/python -m first_boot.gate --require factory-test-passed
ExecStart=/opt/ecobin/factory-test/current/.venv/bin/python -m first_boot.cellular_service
Restart=on-failure
RestartSec=10
TimeoutStartSec=60
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/etc/NetworkManager/system-connections
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
