[Unit]
Description=EcoBin fact-driven first-boot coordinator
Requires=ecobin-expand-rootfs.service ecobin-mcu-safe-gpio.service ecobin-edge-store-prepare.service ecobin-factory-egress-lock.service
After=local-fs.target ecobin-expand-rootfs.service ecobin-mcu-safe-gpio.service ecobin-edge-store-prepare.service ecobin-factory-egress-lock.service
Before=network-pre.target ecobin-enrollment.service ecobin-remote-support.service ecobin-hardware.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=ecobin-factory-web
WorkingDirectory=/opt/ecobin/factory-test/current/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ecobin/factory-test/current/.venv/bin/python -m first_boot.orchestrator
Restart=always
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=15
UMask=0077
LimitCORE=0
StateDirectory=ecobin/first-boot
StateDirectoryMode=0700
RuntimeDirectory=ecobin/factory-portal
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/ecobin
ReadWritePaths=/var/lib/ecobin/first-boot
ReadWritePaths=-/var/lib/ecobin/hardware
ReadWritePaths=-/var/lib/ecobin/factory-test
ReadWritePaths=-/run/ecobin/factory-test
ReadWritePaths=/etc/ecobin
ReadWritePaths=/opt/ecobin/enrollment
ReadWritePaths=/run/ecobin/factory-portal
ReadWritePaths=/run/ecobin/factory-network
ReadWritePaths=/run/lock/ecobin
ReadWritePaths=/etc/NetworkManager/system-connections
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
RequiredBy=network-pre.target
