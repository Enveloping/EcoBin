[Unit]
Description=EcoBin replaceable low-privilege business runtime candidate
ConditionPathExists=!/var/lib/ecobin/device-management-maintenance/runtime-start-blocked.json
ConditionPathExists=/var/lib/ecobin/privileged/business-runtime-cutover/active.json
ConditionPathExists=!/var/lib/ecobin/privileged/business-runtime-cutover/pending.json
ConditionPathExists=!/var/lib/ecobin/privileged/business-snapshots/.restore-in-progress.json
ConditionPathExists=/var/lib/ecobin/business/device-identity.json
ConditionPathExists=/var/lib/ecobin/device-capabilities.json
ConditionPathExists=/opt/ecobin/business/current/release.env
Wants=network-online.target ecobin-remote-support.service
Requires=ecobin-mcu-safe-gpio.service ecobin-enrollment.service ecobin-communication-proxy.service ecobin-updater-candidate.service
After=network-online.target ecobin-mcu-safe-gpio.service ecobin-enrollment.service ecobin-communication-proxy.service ecobin-updater-candidate.service ecobin-remote-support.service
PartOf=ecobin-business-runtime.target
Conflicts=ecobin-hardware.service ecobin-business.service ecobin-factory-test.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=ecobin-business
Group=ecobin-business
SupplementaryGroups=dialout video ecobin-communication-ipc ecobin-business-ipc ecobin-updater-ipc
WorkingDirectory=/opt/ecobin/business/current/app
EnvironmentFile=/etc/ecobin/hardware.env
EnvironmentFile=/opt/ecobin/business/current/release.env
ExecStartPre=/opt/ecobin/business/current/.venv/bin/python /usr/lib/ecobin/business_runtime_preflight.py --posture proxy-candidate
ExecStart=/opt/ecobin/business/current/.venv/bin/python /opt/ecobin/business/current/app/main.py
Restart=always
RestartSec=5
TimeoutStartSec=180
KillSignal=SIGTERM
TimeoutStopSec=30
Environment=ECOBIN_CONFIG_MODE=production
Environment=ECOBIN_CLOUD_TRANSPORT_MODE=local-proxy
Environment=ECOBIN_STAGE4_JOB_GATE_MODE=candidate
Environment=ECOBIN_BUSINESS_CONTROL_MODE=candidate
Environment=ECOBIN_BUSINESS_CONTROL_SOCKET=/run/ecobin/business/control.sock
Environment=ECOBIN_COMMUNICATION_SOCKET=/run/ecobin/communication/control.sock
Environment=ECOBIN_UPDATER_CONTROL_SOCKET=/run/ecobin/updater/control.sock
Environment=ECOBIN_DATA_DIR=/var/lib/ecobin/business
Environment=ECOBIN_EDGE_STORE_PATH=/var/lib/ecobin/business/edge.db
Environment=ECOBIN_EDGE_BOOT_ID_PATH=/var/lib/ecobin/business/edge-boot-id
Environment=ECOBIN_DEVICE_CONFIG_PATH=/var/lib/ecobin/business/device-config.json
Environment=ECOBIN_MCU_FIRMWARE_CACHE_DIR=/var/lib/ecobin/business/mcu-firmware
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=/dev/ttyS5 rw
DeviceAllow=char-video4linux rw
InaccessiblePaths=-/etc/ecobin/device-credentials.json
InaccessiblePaths=-/etc/ecobin/remote-support-credentials.json
InaccessiblePaths=-/var/lib/ecobin/communication
InaccessiblePaths=-/var/lib/ecobin/updater
InaccessiblePaths=-/var/lib/ecobin/hardware
InaccessiblePaths=-/var/lib/ecobin/privileged
ReadWritePaths=/var/lib/ecobin/business /run/ecobin/business
ReadOnlyPaths=-/run/ecobin/communication
ReadOnlyPaths=-/run/ecobin/updater
ReadOnlyPaths=-/run/ecobin/remote-support
