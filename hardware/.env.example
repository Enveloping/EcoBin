# EcoBin 设备侧环境变量模板
# 使用方法: cp .env.example .env 然后填入你的真实凭证

# ── OneNet 设备凭证（必填）──
ECOBIN_PRODUCT_ID=你的产品ID
ECOBIN_DEVICE_NAME=你的设备名
ECOBIN_DEVICE_KEY=你的设备密钥Base64

# ── COS 可信公开环境（与后端当前环境保持一致）──
# 设备仍只接收 OneNet 下发的短期 STS，不读取永久 SecretId/SecretKey。
ECOBIN_COS_REGION=ap-shanghai
ECOBIN_COS_BUCKET_NAME=ecobin-1258140596
ECOBIN_COS_BASE_URL=https://ecobin-1258140596.cos.ap-shanghai.myqcloud.com
# 连接或读取异常时让上传回到可重试状态，避免永久卡在 SDK 调用。
ECOBIN_COS_REQUEST_TIMEOUT_SECONDS=15

# ── MQTT（可选，有默认值）──
ECOBIN_MQTT_HOST=studio-mqtt.heclouds.com
ECOBIN_MQTT_PORT=1883
ECOBIN_MQTT_CLEAN_SESSION=true

# ── 串口（可选）──
ECOBIN_SERIAL_PORT=/dev/ttyS5
ECOBIN_SERIAL_BAUDRATE=115200
# fixed-frame=当前协商协议；uart-v1=保留的 Registry/CRC/ACK 实现
ECOBIN_MCU_PROTOCOL=fixed-frame
# 真实 MCU 必须为 false；连接 PTY 模拟器时必须显式改为 true。
ECOBIN_MCU_SIMULATED=false
# fixed-frame 固定为 1；uart-v1 按实际设备端口数设置
ECOBIN_UART_PORT_COUNT=1
# 无真实 MCU 时，把该路径设置为定长帧 PTY 模拟器提供的稳定软链接。
# ECOBIN_SERIAL_PORT=/tmp/ecobin-fixed-frame-mcu
# ECOBIN_MCU_SIMULATED=true
# 仅限 HIL：当前配置/快照切片为 0x300。生产环境必须留空以严格要求 0x1fff。
# ECOBIN_UART_HIL_REQUIRED_CAPABILITIES=0x300
# 等待 MCU 开关盖状态的超时秒数
ECOBIN_DOOR_STATE_TIMEOUT=5
# 开盖后等待本次最终重量的超时秒数
ECOBIN_DELIVERY_WEIGHT_TIMEOUT=120
# OneNet 单价等设备配置的本地持久化路径
ECOBIN_DEVICE_CONFIG_PATH=./data/device-config.json

# ── 摄像头（按 USB 设备稳定标识，不使用会漂移的 /dev/videoN 数字索引）──
# 无摄像头时可分别设置为 simulated://outside 和 simulated://inside。
# DECXIN = 外部摄像头，当前解析为 /dev/video3；/dev/video4 是 metadata。
# icspring = 内部摄像头，当前解析为 /dev/video0；/dev/video1 是 metadata。
ECOBIN_CAMERA_OUTSIDE=/dev/v4l/by-id/usb-DECXIN_CAMERA_DECXIN_CAMERA_01.00.00-video-index0
ECOBIN_CAMERA_INSIDE=/dev/v4l/by-id/usb-icSpring_icspring_camera-video-index0
# 打开摄像头后读取多帧，丢弃曝光/分辨率尚未稳定的首帧。
ECOBIN_CAMERA_WARMUP_FRAMES=5

# ── 持久化与后台任务（可选，有默认值）──
ECOBIN_DATA_DIR=./data
ECOBIN_EDGE_STORE_PATH=./data/edge.db
ECOBIN_EDGE_BOOT_ID_PATH=./data/edge-boot-id
ECOBIN_EDGE_VERSION=0.1.0
ECOBIN_PHOTO_UPLOAD_POLL_SECONDS=1
ECOBIN_PHOTO_GRANT_EXPIRY_SKEW_SECONDS=30
ECOBIN_PHOTO_RETENTION_HOURS=72

# COS 上传只接受后端通过 OneNet cosGrant 下发的短期 STS 凭证。
# 不要在 .env 中配置永久 SecretId、SecretKey 或后端密钥。
