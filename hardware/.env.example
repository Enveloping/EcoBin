# EcoBin 设备侧环境变量模板
# 使用方法: cp .env.example .env 然后填入你的真实凭证

# ── OneNet 设备凭证（必填）──
ECOBIN_PRODUCT_ID=你的产品ID
ECOBIN_DEVICE_NAME=你的设备名
ECOBIN_DEVICE_KEY=你的设备密钥Base64

# ── MQTT（可选）──
ECOBIN_MQTT_HOST=mqtts.heclouds.com
ECOBIN_MQTT_PORT=1883

# ── 串口（可选）──
ECOBIN_SERIAL_PORT=/dev/ttyS3
ECOBIN_SERIAL_BAUDRATE=115200

# ── 摄像头（可选）──
ECOBIN_CAMERA_OUTSIDE=0
ECOBIN_CAMERA_INSIDE=1

# ── 测试模式（可选，默认 false）──
# 开启后串口和摄像头数据均为模拟，无需实际硬件连接
# 注意：MQTT 和 COS 上传仍使用真实实现，需配置 OneNet 凭证
ECOBIN_TEST_MODE=false
