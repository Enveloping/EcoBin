[Unit]
Description=EcoBin permanent local device updater (remote updates disabled)
ConditionPathExists=!/var/lib/ecobin/device-management-maintenance/runtime-start-blocked.json
ConditionPathExists=!/var/lib/ecobin/privileged/business-runtime-cutover/pending.json
ConditionPathExists=!/var/lib/ecobin/privileged/business-runtime-cutover/active.json
Requires=ecobin-mcu-safe-gpio.service
After=local-fs.target ecobin-mcu-safe-gpio.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=ecobin-updater
Group=ecobin-updater-ipc
SupplementaryGroups=ecobin-communication-ipc ecobin-business-ipc ecobin-privileged-helper-ipc
WorkingDirectory=/opt/ecobin/updater/current/app
EnvironmentFile=/usr/share/ecobin/device-management-release.env
ExecStart=/usr/bin/python3 /opt/ecobin/updater/current/app/updater_agent.py --enable-stage4-candidate --allow-root-business --business-uid 0 --state /var/lib/ecobin/updater/updater.db --socket /run/ecobin/updater/control.sock --socket-group ecobin-updater-ipc --release-version ${ECOBIN_DEVICE_UPDATER_VERSION} --allowed-uid 0 --allowed-user ecobin-communication --allowed-user ecobin-business
Restart=always
RestartSec=2
TimeoutStartSec=30
KillSignal=SIGTERM
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0007
LimitCORE=0
RuntimeDirectory=ecobin/updater
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=ecobin/updater
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
DevicePolicy=closed
InaccessiblePaths=-/etc/ecobin
InaccessiblePaths=-/var/lib/ecobin/business
InaccessiblePaths=-/var/lib/ecobin/communication
ReadOnlyPaths=-/run/ecobin/business
ReadOnlyPaths=-/run/ecobin/communication
ReadOnlyPaths=/usr/share/ecobin/runtime-release-keys
