[Unit]
Description=EcoBin managed business runtime cutover integrity gate
ConditionPathExists=!/var/lib/ecobin/device-management-maintenance/runtime-start-blocked.json
ConditionPathExists=/var/lib/ecobin/privileged/business-runtime-cutover/active.json
ConditionPathExists=!/var/lib/ecobin/privileged/business-runtime-cutover/pending.json
After=local-fs.target
PartOf=ecobin-business-runtime.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
WorkingDirectory=/opt/ecobin/updater/current/app
ExecStart=/opt/ecobin/updater/current/.venv/bin/python /opt/ecobin/updater/current/app/business_runtime_cutover.py verify-active
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=30
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
DevicePolicy=closed
InaccessiblePaths=-/etc/ecobin
InaccessiblePaths=-/var/lib/ecobin/communication
InaccessiblePaths=-/var/lib/ecobin/updater
InaccessiblePaths=-/var/lib/ecobin/hardware
ReadOnlyPaths=/var/lib/ecobin/business
ReadOnlyPaths=/var/lib/ecobin/privileged/business-runtime-cutover
