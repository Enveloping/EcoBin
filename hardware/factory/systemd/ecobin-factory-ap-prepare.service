[Unit]
Description=EcoBin short-lived factory AP interface preparation
Documentation=file:/opt/ecobin/factory-test/current/app/factory/README.md
PartOf=ecobin-factory.target
Requires=ecobin-factory-egress-lock.service ecobin-mcu-safe-gpio.service
After=ecobin-factory-egress-lock.service ecobin-mcu-safe-gpio.service NetworkManager.service
BindsTo=sys-subsystem-net-devices-wlan0.device
After=sys-subsystem-net-devices-wlan0.device
Conflicts=hostapd.service dnsmasq.service wpa_supplicant@wlan0.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/ecobin/factory-test/current/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ecobin/factory-test/current/.venv/bin/python -m factory.ap_supervisor prepare
ExecStop=/opt/ecobin/factory-test/current/.venv/bin/python -m factory.ap_supervisor cleanup
RemainAfterExit=yes
TimeoutStartSec=30
TimeoutStopSec=15
UMask=0077
RuntimeDirectory=ecobin/factory-network
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
InaccessiblePaths=-/etc/ecobin/enrollment.key
InaccessiblePaths=-/etc/ecobin/device-credentials.json
InaccessiblePaths=-/etc/ecobin/remote-support-credentials.json
InaccessiblePaths=-/etc/ecobin/cellular.env
InaccessiblePaths=-/etc/ecobin/hardware.env
InaccessiblePaths=-/etc/ssh
InaccessiblePaths=-/var/lib/ecobin/hardware
ReadWritePaths=/run/ecobin/factory-network
BindReadOnlyPaths=/var/lib/ecobin/hardware:/run/ecobin/factory-network/edge-store
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
