[Unit]
Description=EcoBin low-privilege local factory portal
Documentation=file:/opt/ecobin/factory-test/current/app/factory/README.md
PartOf=ecobin-factory.target
Requires=ecobin-factory-ap.service
After=ecobin-factory-ap.service

[Service]
Type=simple
User=ecobin-factory-web
Group=ecobin-factory-web
WorkingDirectory=/opt/ecobin/factory-test/current/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ecobin/factory-test/current/.venv/bin/python -m factory.portal
Restart=on-failure
RestartSec=2
TimeoutStartSec=15
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
InaccessiblePaths=-/etc/ecobin/enrollment.key
InaccessiblePaths=-/etc/ecobin/setup-ap.key
InaccessiblePaths=-/etc/ecobin/device-credentials.json
InaccessiblePaths=-/etc/ecobin/remote-support-credentials.json
InaccessiblePaths=-/etc/ecobin/hardware.env
InaccessiblePaths=-/etc/ecobin/cellular.env
InaccessiblePaths=-/etc/ssh
InaccessiblePaths=-/var/lib/ecobin
InaccessiblePaths=-/run/ecobin/factory-network
ReadOnlyPaths=-/usr/share/ecobin/image-release.json
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=10.42.0.0/24
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:80
ReadOnlyPaths=-/run/ecobin/factory-test
