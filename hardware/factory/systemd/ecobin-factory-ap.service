[Unit]
Description=EcoBin verified isolated factory access point
Documentation=file:/opt/ecobin/factory-test/current/app/factory/README.md
PartOf=ecobin-factory.target
Requires=ecobin-factory-hostapd.service ecobin-factory-dnsmasq.service
Requires=ecobin-factory-egress-lock.service ecobin-mcu-safe-gpio.service
After=ecobin-factory-hostapd.service ecobin-factory-dnsmasq.service
After=ecobin-factory-egress-lock.service ecobin-mcu-safe-gpio.service
Before=ecobin-factory-portal.service

[Service]
Type=notify
NotifyAccess=main
User=ecobin-factory-web
Group=ecobin-factory-web
WorkingDirectory=/opt/ecobin/factory-test/current/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ecobin/factory-test/current/.venv/bin/python -m factory.ap_supervisor monitor
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=10
WatchdogSec=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
InaccessiblePaths=-/etc/ecobin
InaccessiblePaths=-/var/lib/ecobin
InaccessiblePaths=-/run/ecobin/factory-network/hostapd
InaccessiblePaths=-/run/ecobin/factory-network/dnsmasq
InaccessiblePaths=-/run/ecobin/factory-network/dnsmasq-state
InaccessiblePaths=-/run/ecobin/factory-network/edge-store
ReadOnlyPaths=/run/ecobin/factory-network/ap-allowed.json
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_NETLINK AF_UNIX
IPAddressDeny=any
IPAddressAllow=10.42.0.1/32
