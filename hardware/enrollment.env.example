# Installed as /etc/ecobin/enrollment.env with mode 0600.
# K1 itself is NOT stored here. Put its Base64 value in
# /etc/ecobin/enrollment.key with mode 0600.
ECOBIN_ENROLLMENT_BACKEND_URL=https://api.example.com
ECOBIN_ENROLLMENT_KEY_ID=K1
ECOBIN_ENROLLMENT_MODE=SELF_ENROLLMENT

# Only for one-time adoption of an existing device. The referenced file
# contains the current OneNet device secret and is deleted after READY is
# durably installed.
# ECOBIN_ENROLLMENT_MODE=LEGACY_ADOPTION
# ECOBIN_LEGACY_ONENET_SECRET_FILE=/etc/ecobin/legacy-onenet-secret
