[Unit]
Description=EcoBin Orange Pi hardware gateway
Wants=network-online.target ecobin-remote-support.service
Requires=ecobin-enrollment.service
After=network-online.target ecobin-enrollment.service ecobin-remote-support.service
ConditionPathExists=/etc/ecobin/device-credentials.json
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/root/EcoBin/hardware
ExecStart=/root/EcoBin/hardware/.venv/bin/python /root/EcoBin/hardware/main.py
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
Environment=PYTHONUNBUFFERED=1
UMask=0077

[Install]
WantedBy=multi-user.target
