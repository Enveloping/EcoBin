[Unit]
Description=EcoBin Orange Pi hardware gateway
ConditionPathExists=!/var/lib/ecobin/privileged/business-runtime-cutover/pending.json
ConditionPathExists=!/var/lib/ecobin/privileged/business-runtime-cutover/active.json
Wants=network-online.target ecobin-remote-support.service ecobin-updater.service
Requires=ecobin-mcu-safe-gpio.service ecobin-enrollment.service
After=network-online.target ecobin-mcu-safe-gpio.service ecobin-enrollment.service ecobin-remote-support.service ecobin-updater.service
ConditionPathExists=/etc/ecobin/device-credentials.json
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=root
WorkingDirectory=/opt/ecobin/hardware/current/app
EnvironmentFile=/etc/ecobin/hardware.env
EnvironmentFile=/opt/ecobin/hardware/current/release.env
ExecStartPre=/usr/bin/python3 /usr/lib/ecobin/mcu_safe_gpio.py --gpio-path /usr/bin/gpio
ExecStart=/opt/ecobin/hardware/current/.venv/bin/python /opt/ecobin/hardware/current/app/main.py
Restart=always
RestartSec=5
TimeoutStartSec=180
KillSignal=SIGTERM
TimeoutStopSec=25
Environment=ECOBIN_CONFIG_MODE=production
Environment=ECOBIN_STAGE4_JOB_GATE_MODE=candidate
Environment=ECOBIN_BUSINESS_CONTROL_MODE=status
Environment=ECOBIN_BUSINESS_CONTROL_SOCKET=/run/ecobin/business/control.sock
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
LimitCORE=0
StateDirectory=ecobin/hardware
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
