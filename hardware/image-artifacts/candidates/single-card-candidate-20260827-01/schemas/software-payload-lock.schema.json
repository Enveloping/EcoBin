{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.jinshoubao.com/schemas/orangepi/software-payload-lock-v1.json",
  "title": "EcoBin controlled image software payload lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lockState", "payloadId", "sourceGitCommit", "components", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "lockState": {"const": "LOCKED"},
    "payloadId": {"$ref": "#/$defs/releaseId"},
    "sourceGitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardwareRuntime", "enrollment", "remoteSupport", "factoryTest", "firstBoot"],
      "properties": {
        "hardwareRuntime": {"$ref": "#/$defs/rootComponent"},
        "enrollment": {"$ref": "#/$defs/venvComponent"},
        "remoteSupport": {"$ref": "#/$defs/venvComponent"},
        "factoryTest": {"$ref": "#/$defs/venvComponent"},
        "firstBoot": {"$ref": "#/$defs/identityComponent"}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/directoryEntry"},
          {"$ref": "#/$defs/fileEntry"},
          {"$ref": "#/$defs/symlinkEntry"}
        ]
      }
    }
  },
  "$defs": {
    "releaseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "identityComponent": {
      "type": "object", "additionalProperties": false, "required": ["releaseId"],
      "properties": {"releaseId": {"$ref": "#/$defs/releaseId"}}
    },
    "rootComponent": {
      "type": "object", "additionalProperties": false, "required": ["releaseId", "root"],
      "properties": {"releaseId": {"$ref": "#/$defs/releaseId"}, "root": {"$ref": "#/$defs/relativePath"}}
    },
    "venvComponent": {
      "type": "object", "additionalProperties": false, "required": ["releaseId", "venv"],
      "properties": {"releaseId": {"$ref": "#/$defs/releaseId"}, "venv": {"$ref": "#/$defs/relativePath"}}
    },
    "baseEntry": {
      "type": "object",
      "required": ["path", "type", "mode"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "mode": {"type": "string", "pattern": "^0[0-7]{3}$"}
      }
    },
    "directoryEntry": {
      "allOf": [
        {"$ref": "#/$defs/baseEntry"},
        {"type": "object", "additionalProperties": false, "required": ["path", "type", "mode"], "properties": {"path": {"$ref": "#/$defs/relativePath"}, "type": {"const": "directory"}, "mode": {"type": "string"}}}
      ]
    },
    "fileEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "type", "mode", "size", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"}, "type": {"const": "file"}, "mode": {"type": "string", "pattern": "^0[0-7]{3}$"},
        "size": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "symlinkEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "type", "mode", "target"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"}, "type": {"const": "symlink"}, "mode": {"type": "string", "pattern": "^0[0-7]{3}$"}, "target": {"type": "string", "minLength": 1}
      }
    }
  }
}
