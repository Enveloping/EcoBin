[Unit]
Description=EcoBin independent remote maintenance tunnel agent
Wants=network-online.target
Requires=ecobin-enrollment.service
After=network-online.target ecobin-enrollment.service
ConditionPathExists=/etc/ecobin/remote-support-credentials.json
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=ecobin-remote
Group=ecobin-remote
WorkingDirectory=/opt/ecobin/remote-support/current/app
LoadCredential=remote-support.json:/etc/ecobin/remote-support-credentials.json
ExecStart=/opt/ecobin/remote-support/current/.venv/bin/python /opt/ecobin/remote-support/current/app/remote_support_agent.py --credentials %d/remote-support.json --state /var/lib/ecobin/remote-support/state.db --socket /run/ecobin/remote-support/control.sock --runtime-directory /run/ecobin/remote-support --allowed-uid 0
Restart=always
RestartSec=2
TimeoutStartSec=30
KillSignal=SIGTERM
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
LimitCORE=0
RuntimeDirectory=ecobin/remote-support
RuntimeDirectoryMode=0700
StateDirectory=ecobin/remote-support
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
