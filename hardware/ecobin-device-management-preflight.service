[Unit]
Description=EcoBin boot-scoped privileged-helper health preflight
Requires=ecobin-business-activation-helper.socket ecobin-mcu-flash-helper.socket
After=local-fs.target ecobin-business-activation-helper.socket ecobin-mcu-flash-helper.socket

[Service]
Type=oneshot
RemainAfterExit=yes
User=ecobin-updater
Group=ecobin-updater-ipc
SupplementaryGroups=ecobin-privileged-helper-ipc
WorkingDirectory=/opt/ecobin/updater/current/app
ExecStart=/usr/bin/python3 /opt/ecobin/updater/current/app/device_management_preflight.py
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=20
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
DevicePolicy=closed
InaccessiblePaths=-/etc/ecobin
InaccessiblePaths=-/var/lib/ecobin/business
InaccessiblePaths=-/var/lib/ecobin/communication
InaccessiblePaths=-/var/lib/ecobin/hardware
InaccessiblePaths=-/var/lib/ecobin/remote-support
