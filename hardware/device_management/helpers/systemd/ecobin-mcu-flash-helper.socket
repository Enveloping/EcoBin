[Unit]
Description=EcoBin on-demand MCU flash helper socket
ConditionPathExists=!/var/lib/ecobin/device-management-maintenance/runtime-start-blocked.json
ConditionPathExists=!/var/lib/ecobin/privileged/business-runtime-cutover/pending.json
ConditionPathExists=!/var/lib/ecobin/privileged/business-runtime-cutover/active.json
Requires=ecobin-mcu-safe-gpio.service
After=ecobin-mcu-safe-gpio.service

[Socket]
ListenStream=/run/ecobin/privileged/mcu-flash.sock
Accept=yes
SocketUser=root
SocketGroup=ecobin-privileged-helper-ipc
SocketMode=0660
DirectoryMode=0750
Backlog=8
MaxConnections=1
RemoveOnStop=yes
FlushPending=yes
