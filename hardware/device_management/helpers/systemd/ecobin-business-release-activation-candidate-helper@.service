[Unit]
Description=EcoBin authorized stage-six business release activation helper
ConditionPathExists=!/var/lib/ecobin/device-management-maintenance/runtime-start-blocked.json
ConditionPathExists=/var/lib/ecobin/privileged/business-runtime-cutover/active.json
ConditionPathExists=!/var/lib/ecobin/privileged/business-runtime-cutover/pending.json
Requires=ecobin-updater-candidate.service
After=ecobin-updater-candidate.service
PartOf=ecobin-business-runtime.target

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/usr/lib/ecobin/device-management
ExecStart=/usr/bin/python3 -m helpers.business_release_activation_candidate_helper
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStartSec=900
RuntimeMaxSec=900
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
DevicePolicy=closed
InaccessiblePaths=-/etc/ecobin
InaccessiblePaths=-/etc/shadow
InaccessiblePaths=-/etc/gshadow
InaccessiblePaths=-/etc/ssh
InaccessiblePaths=-/var/lib/ecobin/communication
InaccessiblePaths=-/var/lib/ecobin/hardware
InaccessiblePaths=-/var/lib/ecobin/remote-support
InaccessiblePaths=-/var/lib/ecobin/updater/updater.db
InaccessiblePaths=-/var/lib/ecobin/updater/mcu-updates.db
InaccessiblePaths=-/var/lib/ecobin/updater/mcu-firmware
InaccessiblePaths=-/usr/share/ecobin/runtime-release-keys
InaccessiblePaths=-/usr/share/ecobin/business-release-keys
InaccessiblePaths=-/usr/share/ecobin/mcu-release-keys
ReadWritePaths=/run/ecobin/privileged/mutation.lock
ReadOnlyPaths=/run/ecobin/updater
ReadWritePaths=-/var/lib/ecobin/updater/staging
ReadWritePaths=-/opt/ecobin/business
ReadWritePaths=-/var/lib/ecobin/business
ReadWritePaths=/var/lib/ecobin/privileged/business-snapshots
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
