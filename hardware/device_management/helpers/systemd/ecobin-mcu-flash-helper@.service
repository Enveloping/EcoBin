[Unit]
Description=EcoBin one-shot fixed MCU flash helper
ConditionPathExists=!/var/lib/ecobin/device-management-maintenance/runtime-start-blocked.json
Requires=ecobin-mcu-safe-gpio.service
After=ecobin-mcu-safe-gpio.service

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/usr/lib/ecobin/device-management
ExecStart=/usr/bin/python3 -m helpers.mcu_flash_helper
ExecStopPost=/usr/bin/python3 -m helpers.mcu_flash_recovery
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStartSec=360
RuntimeMaxSec=360
TimeoutStopSec=90
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_RAWIO
DevicePolicy=closed
DeviceAllow=/dev/ttyS5 rw
DeviceAllow=/dev/gpiomem rw
DeviceAllow=/dev/mem rw
InaccessiblePaths=-/etc/ecobin
InaccessiblePaths=-/etc/shadow
InaccessiblePaths=-/etc/gshadow
InaccessiblePaths=-/etc/ssh
InaccessiblePaths=-/var/lib/ecobin/business
InaccessiblePaths=-/var/lib/ecobin/communication
InaccessiblePaths=-/var/lib/ecobin/hardware
InaccessiblePaths=-/var/lib/ecobin/remote-support
InaccessiblePaths=-/var/lib/ecobin/updater/updater.db
InaccessiblePaths=-/var/lib/ecobin/updater/staging
InaccessiblePaths=-/var/lib/ecobin/privileged/business-snapshots
InaccessiblePaths=-/usr/share/ecobin/runtime-release-keys
ReadOnlyPaths=-/var/lib/ecobin/updater/mcu-firmware
ReadWritePaths=/run/ecobin/privileged/mutation.lock
ReadWritePaths=-/run/ecobin/privileged/mcu-application-recovery-required
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
