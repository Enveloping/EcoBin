[Unit]
Description=EcoBin stage-six business release activation helper socket
ConditionPathExists=!/var/lib/ecobin/device-management-maintenance/runtime-start-blocked.json
ConditionPathExists=/var/lib/ecobin/privileged/business-runtime-cutover/active.json
ConditionPathExists=!/var/lib/ecobin/privileged/business-runtime-cutover/pending.json
Requires=ecobin-updater-candidate.service
After=ecobin-updater-candidate.service
PartOf=ecobin-business-runtime.target

[Socket]
ListenStream=/run/ecobin/privileged/business-release-activation-candidate.sock
Accept=yes
SocketUser=root
SocketGroup=ecobin-privileged-helper-ipc
SocketMode=0660
DirectoryMode=0750
Backlog=8
MaxConnections=1
RemoveOnStop=yes
FlushPending=yes
