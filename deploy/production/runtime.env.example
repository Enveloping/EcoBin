# Non-secret production runtime configuration.
# Secrets are mounted as files under /run/secrets and must not be added here.
dbUrl=jdbc:mysql://ecobin-target-mysql84:3306/ecobin?useUnicode=true&characterEncoding=utf-8&serverTimezone=UTC
dbUsername=ecobin_app
defaultPlatformAdminEnabled=false
externalMode=fake
onenetSubscriptionEnabled=false
TZ=UTC

# REAL mode is enabled only after every corresponding secret and certificate
# has been installed outside Git and the callback domain is publicly ready.
# Uncomment and fill the complete block together; do not partially enable it.
# externalMode=real
# wechatAppid=wx0000000000000000
# iotSubscriptionName=replace-with-onenet-subscription-name
# onenetProductId=replace-with-onenet-product-id
# cosRegion=ap-shanghai
# cosBucketName=replace-with-bucket-appid
# cosBaseUrl=https://replace-with-bucket-appid.cos.ap-shanghai.myqcloud.com
# cosDurationSeconds=1800
# wechatPayMchid=0000000000
# wechatPayMerchantSerialNumber=REPLACE_WITH_CERTIFICATE_SERIAL
# wechatPayMerchantPrivateKeyPath=/run/secrets/wechatpay/apiclient_key.pem
# wechatPayPlatformCertificatePath=/run/secrets/wechatpay/wechatpay_platform_cert.pem
# wechatPayNotifyBaseUrl=https://www.jinshoubao.com
# wechatPayTransferSceneId=1010
# onenetSubscriptionEnabled=true
