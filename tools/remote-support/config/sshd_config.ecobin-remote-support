# EcoBin on-demand support boundary. Installed as 60-ecobin-remote-support.conf.
# This template requires OpenSSH with permitlisten, expiry-time and
# UnusedConnectionTimeout support. The installer validates the effective config.

Match User ecobin-tunnel
    AuthenticationMethods publickey
    PubkeyAuthentication yes
    PubkeyAcceptedAlgorithms ssh-ed25519
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    GSSAPIAuthentication no
    HostbasedAuthentication no
    AuthorizedKeysFile none
    AuthorizedKeysCommand /usr/local/libexec/ecobin-remote-support/authorized-keys %u %t %k %f
    AuthorizedKeysCommandUser ecobin-lease-reader
    AllowTcpForwarding remote
    AllowStreamLocalForwarding no
    PermitListen 127.0.0.1:22011 127.0.0.1:22012 127.0.0.1:22013 127.0.0.1:22014
    PermitOpen none
    GatewayPorts no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTTY no
    PermitUserRC no
    PermitTunnel no
    MaxSessions 1
    ClientAliveInterval 15
    ClientAliveCountMax 3
    UnusedConnectionTimeout 15

Match User ecobin-jump
    AuthenticationMethods publickey
    PubkeyAuthentication yes
    PubkeyAcceptedAlgorithms ssh-ed25519-cert-v01@openssh.com
    CASignatureAlgorithms ssh-ed25519
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    GSSAPIAuthentication no
    HostbasedAuthentication no
    TrustedUserCAKeys /etc/ecobin/remote-support/maintenance-user-ca.pub
    AuthorizedPrincipalsFile /etc/ecobin/remote-support/jump-authorized-principals
    AuthorizedKeysFile none
    AllowTcpForwarding local
    AllowStreamLocalForwarding no
    PermitOpen 127.0.0.1:22011 127.0.0.1:22012 127.0.0.1:22013 127.0.0.1:22014
    PermitListen none
    GatewayPorts no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTTY no
    PermitUserRC no
    PermitTunnel no
    MaxSessions 0
    ClientAliveInterval 15
    ClientAliveCountMax 3
    UnusedConnectionTimeout 30

Match all
