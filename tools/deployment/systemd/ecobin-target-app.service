[Unit]
Description=EcoBin target Web and backend Compose stack
Requires=docker.service ecobin-stage-runtime-secrets.service
After=docker.service ecobin-stage-runtime-secrets.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/ecobin/compose/docker-compose.target-app.yml
ConditionPathExists=/etc/ecobin/deployment.env
ConditionPathExists=/etc/ecobin/runtime.env

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/ecobin/deployment.env
ExecStartPre=/usr/bin/install -d -o 10001 -g 10001 -m 0750 ${ECOBIN_BACKEND_LOG_DIRECTORY}
ExecStartPre=/usr/bin/install -d -o 10001 -g 10001 -m 0700 ${ECOBIN_BUSINESS_RELEASE_UPLOAD_DIRECTORY}
ExecStartPre=/usr/local/sbin/ecobin-production-preflight
ExecStart=/usr/local/sbin/ecobin-target-app-compose up
ExecReload=/usr/local/sbin/ecobin-target-app-compose reload
ExecStop=/usr/local/sbin/ecobin-target-app-compose stop
TimeoutStartSec=300
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
