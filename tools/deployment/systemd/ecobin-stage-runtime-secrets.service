[Unit]
Description=Stage EcoBin runtime secrets into tmpfs
After=local-fs.target
ConditionPathIsDirectory=/etc/ecobin/secrets

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ecobin-stage-runtime-secrets
RemainAfterExit=yes
UMask=0027
RuntimeDirectory=ecobin-secrets
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=-/run/ecobin-secrets

[Install]
WantedBy=multi-user.target
