# ===== Docker MySQL 初始化边界（仅环境供应使用）=====
MYSQL_DATABASE=ecobin
MYSQL_ROOT_PASSWORD=换成随机的实例初始化密码

# ===== 后端最小运行身份（必须由 H-02/环境供应预先创建和授权）=====
DB_RUNTIME_USERNAME=ecobin_app
DB_RUNTIME_PASSWORD=换成独立的随机运行密码
# 注意 host 用 compose 服务名 mysql；目标库必须已由一次性迁移作业升级到 V10。
dbUrl=jdbc:mysql://mysql:3306/ecobin?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
dbUsername=ecobin_app
dbPassword=与DB_RUNTIME_PASSWORD相同的外部注入值

# ===== F-07 默认外联闩锁 =====
externalMode=fake
onenetSubscriptionEnabled=false

# ===== 开发默认平台管理员（仅 externalMode=fake）=====
# 空 iam_platform_admin 表首次启动时创建；已有账号时不会追加或重置。
defaultPlatformAdminEnabled=true
defaultPlatformAdminLogin=admin
defaultPlatformAdminPassword=admin123
defaultPlatformAdminDisplayName=开发平台管理员
# REAL/production 必须设置 defaultPlatformAdminEnabled=false，否则拒绝启动。

# ===== JWT / 加密密钥 =====
#jwtSecret=换成一个足够长的随机串（至少32字节，HS256 需要）
#appAesKey=换成你的AES密钥

# ===== 真实渠道（FAKE 模式必须保持为空；切 REAL 需另行受控供应）=====
#wechatAppid=
#wechatSecret=

# ===== 腾讯云 COS（设备直传图片用的 STS 临时密钥来源）=====
#cosSecretId=
#cosSecretKey=
#cosRegion=ap-shanghai
#cosBucketName=ecobin-1258140596
#cosBaseUrl=https://ecobin-1258140596.cos.ap-shanghai.myqcloud.com
#cosDurationSeconds=1800

# ===== 中国移动 OneNet =====
# 上行（北向 MQ 订阅）
#iotAccessId=
#iotSecretKey=
#iotSubscriptionName=
# 下行（物模型服务调用，发开门指令）—— 已就绪
#onenetProductId=
#onenetAccessKey=
