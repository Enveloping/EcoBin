.search { display: flex; align-items: center; gap: 12rpx; height: 72rpx; padding: 0 22rpx; background: #fff; border: 1rpx solid #e7eae7; border-radius: 24rpx; }.search input { flex: 1; font-size: 23rpx; }.mall-head { display: flex; align-items: center; justify-content: space-between; margin: 24rpx 3rpx; }.mall-head > view { display: flex; align-items: center; gap: 9rpx; font-size: 27rpx; font-weight: 700; }.mall-head > text { color: #8f968f; font-size: 21rpx; }.mall-head > text text { color: #10b927; font-size: 25rpx; font-weight: 700; }
.product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }.product { overflow: hidden; }.product-image { position: relative; display: flex; align-items: center; justify-content: center; height: 226rpx; background: #e4f5e6; }.product-image.blue { background: #e4f2f5; }.product-image.sand { background: #f3eddd; }.product-image.yellow { background: #f7f2cf; }.product-image.rose { background: #f5e7e7; }.badge { position: absolute; top: 14rpx; left: 14rpx; padding: 6rpx 13rpx; color: #fff; font-size: 19rpx; background: #10b927; border-radius: 18rpx; }
.bag { position: relative; width: 72rpx; height: 70rpx; border: 7rpx solid rgba(16,185,39,.45); border-radius: 12rpx; }.bag::before { content: ""; position: absolute; top: -29rpx; left: 15rpx; width: 32rpx; height: 27rpx; border: 7rpx solid rgba(16,185,39,.45); border-bottom: 0; border-radius: 18rpx 18rpx 0 0; }.bag view { width: 16rpx; height: 16rpx; margin: 22rpx auto; border: 5rpx solid rgba(16,185,39,.45); border-top: 0; border-left: 0; transform: rotate(45deg); }
.product-info { padding: 20rpx; }.product-name { display: block; min-height: 42rpx; font-size: 25rpx; font-weight: 650; }.product-info > view { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; }.points { color: #10b927; font-size: 24rpx; font-weight: 700; }.redeem { padding: 9rpx 17rpx; color: #fff; font-size: 20rpx; background: #10b927; border-radius: 24rpx; }
