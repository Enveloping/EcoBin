.bind-page { text-align: center; }.phone-symbol { display: flex; align-items: center; justify-content: center; width: 144rpx; height: 144rpx; margin: 50rpx auto 28rpx; background: #e8f7eb; border-radius: 50%; }.headline { font-size: 34rpx; font-weight: 750; }.subtitle { margin-top: 10rpx; color: #9aa09a; font-size: 23rpx; }
.bind-card { margin-top: 46rpx; padding: 32rpx; text-align: left; }.label { margin-bottom: 12rpx; font-size: 24rpx; font-weight: 650; }.code-label { margin-top: 28rpx; }.bind-card input { height: 82rpx; padding: 0 22rpx; font-size: 24rpx; background: #f7f9f7; border: 2rpx solid #e2e6e2; border-radius: 20rpx; box-sizing: border-box; }.code-row { display: grid; grid-template-columns: 1fr 176rpx; gap: 14rpx; }.send { display: flex; align-items: center; justify-content: center; color: #10a625; font-size: 23rpx; font-weight: 600; background: #e8f7eb; border-radius: 20rpx; }.send.disabled { color: #9ca39c; }.submit { margin-top: 34rpx; }.agreement { margin-top: 38rpx; color: #b1b6b1; font-size: 21rpx; }
