<view class="bind-page eco-page">
  <view class="phone-symbol"><t-icon name="call" size="72rpx" color="#10b927" /></view>
  <view class="headline">绑定手机号码</view><view class="subtitle">绑定后可接收投放通知及积分变动</view>
  <view class="bind-card eco-card">
    <view class="label">手机号码</view><input type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" data-field="phone" bindinput="onInput" />
    <view class="label code-label">验证码</view><view class="code-row"><input type="number" maxlength="6" placeholder="请输入验证码" value="{{code}}" data-field="code" bindinput="onInput" /><view class="send {{seconds ? 'disabled' : ''}}" bindtap="onSendCode">{{seconds ? seconds + 's' : '发送验证码'}}</view></view>
    <view class="eco-primary submit" bindtap="onSubmit">确认绑定</view>
  </view>
  <view class="agreement">绑定即表示同意用户隐私协议</view>
</view>
