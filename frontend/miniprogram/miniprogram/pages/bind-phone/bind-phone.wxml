<view class="bind-page eco-page">
  <view class="phone-symbol"><t-icon name="call" size="72rpx" color="#10b927" /></view>
  <view class="eyebrow">WECHAT VERIFIED</view>
  <view class="headline">{{alreadyBound ? '手机号已完成验证' : '验证手机号码'}}</view>
  <view class="subtitle">{{alreadyBound ? '当前账号已具备后续业务资格' : '号码仅用于当前机构身份核验，不会展示完整号码'}}</view>
  <view class="bind-card eco-card">
    <block wx:if="{{alreadyBound}}">
      <view class="verified-mark"><t-icon name="check-circle-filled" size="48rpx" color="#10a625" /></view>
      <view class="masked">{{maskedPhoneNumber || '已绑定号码'}}</view>
      <view class="state-line">身份状态 · 已验证</view>
      <view class="secondary-action" bindtap="onBack">返回</view>
    </block>
    <block wx:else>
      <view class="privacy-row">
        <t-icon name="lock-on" size="34rpx" color="#0b6b3a" />
        <view>
          <view class="privacy-title">由微信直接提供已验证号码</view>
          <view class="privacy-copy">不接收手工输入，也不使用短信验证码。</view>
        </view>
      </view>
      <button
        class="wechat-phone-button"
        open-type="getPhoneNumber"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindgetphonenumber="onGetPhoneNumber"
      >{{submitting ? '正在验证…' : '微信授权并绑定手机号'}}</button>
    </block>
  </view>
  <view class="agreement">动态授权码仅使用一次；服务端只返回脱敏号码</view>
</view>
