.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 160rpx;
  background: #f5f6f7;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.clean-phone-notice {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.clean-phone-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.clean-phone-title {
  color: #173d25;
  font-size: 26rpx;
  font-weight: 700;
}

.clean-phone-detail {
  margin-top: 8rpx;
  color: #78837a;
  font-size: 21rpx;
}

.clean-phone-action {
  width: auto;
  margin: 0;
  padding: 18rpx 22rpx;
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
  background: #10a625;
  border-radius: 18rpx;
}

.clean-phone-action::after { border: 0; }
.clean-phone-action[disabled] { background: #73c780; }

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.field-label {
  font-size: 28rpx;
  color: #333;
}

.field-value {
  font-size: 28rpx;
  color: #222;
}

.field-value.placeholder {
  color: #bbb;
}

.bag-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.bag-btn {
  flex: 1;
}

.submit-btn {
  margin-top: 36rpx;
}

.tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #aaa;
  line-height: 1.5;
}

.clean-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.clean-weight {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.clean-time {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 6rpx;
}

.clean-detail {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.clean-sub {
  font-size: 22rpx;
  color: #888;
}

.clean-bag {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 6rpx;
}
