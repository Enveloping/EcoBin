.clean-page {
  min-height: 100vh;
  padding:
    0
    26rpx
    calc(184rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #eff9f3;
}

.clean-header {
  display: flex;
  height: 116rpx;
  align-items: center;
  justify-content: center;
}

.clean-title {
  color: #14251a;
  font-size: 38rpx;
  font-weight: 780;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.function-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: 22rpx;
  row-gap: 30rpx;
  padding-top: 22rpx;
}

.function-item {
  display: flex;
  min-width: 0;
  align-items: center;
  flex-direction: column;
  transition: opacity .14s ease;
}

.function-item--pressed {
  opacity: .78;
}

.function-item--pressed .function-tile {
  transform: scale(.965);
}

.function-tile {
  display: flex;
  width: 184rpx;
  height: 184rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, .48);
  border-radius: 30rpx;
  box-shadow: 0 14rpx 28rpx rgba(43, 78, 55, .17);
  transition: transform .14s ease;
}

.function-label {
  margin-top: 14rpx;
  color: #18231b;
  font-size: 25rpx;
  font-weight: 620;
  line-height: 1.25;
  text-align: center;
  white-space: nowrap;
}

.tone-primary { background: #5d8fe8; }
.tone-online { background: #2fbd59; }
.tone-idle { background: #35c4c9; }
.tone-clean { background: #ed8c96; }
.tone-full { background: #eb5c62; }
.tone-overdue { background: #dc4b58; }
.tone-records { background: #efb83f; }
