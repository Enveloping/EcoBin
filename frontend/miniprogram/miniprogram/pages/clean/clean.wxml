<view class="clean-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="clean-header">
    <view class="clean-title">清运工作台</view>
  </view>

  <view class="function-grid">
    <view
      class="function-item"
      data-filter="ALL"
      bindtap="onCardTap"
      hover-class="function-item--pressed"
    >
      <view class="function-tile tone-primary">
        <t-icon name="root-list" size="76rpx" color="#ffffff" />
      </view>
      <view class="function-label">全部设备</view>
    </view>

    <view
      class="function-item"
      data-filter="ONLINE"
      bindtap="onCardTap"
      hover-class="function-item--pressed"
    >
      <view class="function-tile tone-online">
        <t-icon name="check-circle" size="76rpx" color="#ffffff" />
      </view>
      <view class="function-label">在线设备</view>
    </view>

    <view
      class="function-item"
      data-filter="NO_DELIVERY_24H"
      bindtap="onCardTap"
      hover-class="function-item--pressed"
    >
      <view class="function-tile tone-idle">
        <t-icon name="time" size="76rpx" color="#ffffff" />
      </view>
      <view class="function-label">一天未投递设备</view>
    </view>

    <view
      class="function-item"
      data-filter="NO_CLEAN_24H"
      bindtap="onCardTap"
      hover-class="function-item--pressed"
    >
      <view class="function-tile tone-clean">
        <t-icon name="time" size="76rpx" color="#ffffff" />
      </view>
      <view class="function-label">一天未清运设备</view>
    </view>

    <view
      class="function-item"
      data-filter="FULL"
      bindtap="onCardTap"
      hover-class="function-item--pressed"
    >
      <view class="function-tile tone-full">
        <t-icon name="error-circle" size="76rpx" color="#ffffff" />
      </view>
      <view class="function-label">满溢设备</view>
    </view>

    <view
      class="function-item"
      data-filter="FULL_TIMEOUT_2H"
      bindtap="onCardTap"
      hover-class="function-item--pressed"
    >
      <view class="function-tile tone-overdue">
        <t-icon name="error-circle" size="76rpx" color="#ffffff" />
      </view>
      <view class="function-label">满溢超时2h</view>
    </view>

    <view
      class="function-item"
      data-filter="RECORDS"
      bindtap="onCardTap"
      hover-class="function-item--pressed"
    >
      <view class="function-tile tone-records">
        <t-icon name="root-list" size="76rpx" color="#ffffff" />
      </view>
      <view class="function-label">清运记录</view>
    </view>
  </view>
</view>
