<view class="profile-page">
  <view class="page-title">我的</view>

  <view class="identity-card">
    <view class="avatar">
      <t-icon name="user" size="62rpx" color="#109d2b" />
    </view>
    <view class="identity-copy">
      <view class="identity-name">{{displayName}}</view>
      <view class="identity-organization">{{organizationName}}</view>
      <view class="identity-role">{{previewOnly ? '清运端界面预览' : '清运人员'}}</view>
    </view>
  </view>

  <view
    class="account-switch"
    bindtap="onSwitchOrganization"
    hover-class="account-switch--pressed"
  >
    <view>
      <view class="account-switch-title">切换机构账号</view>
      <view class="account-switch-copy">订单、钱包和手机号仍按机构独立保存</view>
    </view>
    <t-icon name="chevron-right" size="34rpx" color="#8c968e" />
  </view>

  <view wx:if="{{entryPreviewEnabled}}" class="preview-card">
    <view class="preview-copy">
      <view class="preview-title">测试界面预览</view>
      <view class="preview-description">{{previewNotice}}</view>
    </view>
    <button class="preview-button" bindtap="onEntryPreview">切换端</button>
  </view>

  <view class="logout" bindtap="onLogout" hover-class="logout--pressed">退出登录</view>
</view>
