.home-page {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 18rpx) 24rpx calc(178rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f4f7f3;
}

.brandbar {
  display: flex;
  height: 92rpx;
  align-items: center;
  padding: 0 14rpx;
}

.brand-name {
  color: #07951c;
  font-size: 44rpx;
  font-weight: 780;
  letter-spacing: -1rpx;
}

.hero {
  position: relative;
  height: 516rpx;
  padding: 120rpx 36rpx 30rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #edf7e9;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 32rpx rgba(38, 72, 43, .06);
}

.hero-illustration {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-copy {
  position: relative;
  z-index: 1;
  pointer-events: none;
}

.hero-title {
  color: #16251b;
  font-size: 56rpx;
  font-weight: 780;
  letter-spacing: 1rpx;
}
.hero-sub {
  margin-top: 14rpx;
  color: #667168;
  font-size: 30rpx;
}

.home-card {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  margin-top: 24rpx;
  background: #fff;
  border-radius: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(38, 72, 43, .07);
  transition: transform .18s ease, opacity .18s ease;
}
.home-card--pressed { opacity: .84; transform: scale(.99); }
.ongoing-card {
  min-height: 112rpx;
  padding: 20rpx 26rpx;
}
.ongoing-icon {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  background: #e8f7eb;
  border-radius: 22rpx;
}
.ongoing-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 5rpx;
  margin-left: 18rpx;
}
.ongoing-title {
  color: #263329;
  font-size: 27rpx;
  font-weight: 680;
}
.ongoing-sub {
  color: #8a938b;
  font-size: 21rpx;
}
.wallet-card {
  display: grid;
  min-height: 200rpx;
  align-content: center;
  grid-template-columns: 96rpx 1fr 32rpx;
  grid-template-rows: 96rpx;
  column-gap: 24rpx;
  padding: 30rpx 32rpx;
}
.card-icon {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  background: #e8f7eb;
  border-radius: 50%;
}
.card-icon--small {
  width: 64rpx;
  height: 64rpx;
}
.wallet-icon {
  grid-column: 1;
  grid-row: 1;
}
.wallet-value {
  display: flex;
  height: 96rpx;
  min-width: 0;
  grid-column: 2;
  grid-row: 1;
  align-items: center;
  align-self: stretch;
  color: #10a625;
  font-size: 48rpx;
  font-weight: 760;
  font-variant-numeric: tabular-nums;
}
.wallet-value-text {
  display: block;
  line-height: 1;
}
.wallet-value--error {
  color: #9a743d;
  font-size: 23rpx;
  font-weight: 620;
}
.wallet-chevron {
  display: flex;
  grid-column: 3;
  grid-row: 1;
  align-items: center;
  justify-content: center;
}
.recent-card {
  display: block;
  min-height: 304rpx;
  padding: 30rpx 30rpx;
  box-sizing: border-box;
}
.recent-head,
.recent-title,
.recent-more,
.recent-order,
.recent-order-line,
.recent-order-meta,
.recent-loading {
  display: flex;
  align-items: center;
}
.recent-head { justify-content: space-between; }
.recent-title {
  gap: 16rpx;
  font-size: 30rpx;
  font-weight: 680;
}
.recent-more {
  color: #969d96;
  font-size: 23rpx;
}
.recent-order {
  min-height: 156rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  box-sizing: border-box;
  background: #f7faf7;
  border-radius: 24rpx;
  transition: transform .18s ease, opacity .18s ease;
}
.recent-order--pressed { opacity: .82; transform: scale(.99); }
.recent-order-icon {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  background: #e6f5e9;
  border-radius: 24rpx;
}
.recent-order-copy {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
}
.recent-order-line,
.recent-order-meta {
  justify-content: space-between;
}
.recent-order-name { font-size: 30rpx; font-weight: 680; }
.recent-order-weight {
  font-size: 34rpx;
  font-weight: 720;
  font-variant-numeric: tabular-nums;
}
.recent-order-meta {
  margin-top: 10rpx;
  color: #969d96;
  font-size: 22rpx;
}
.status-approved { color: #10a625; }
.status-pending { color: #d58b11; }
.status-attention { color: #c85e4d; }
.recent-loading {
  gap: 18rpx;
  min-height: 156rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  box-sizing: border-box;
  background: #f7faf7;
  border-radius: 24rpx;
}
.loading-icon,
.loading-copy view,
.loading-value {
  background: linear-gradient(90deg, #edf1ed 25%, #f7f9f7 50%, #edf1ed 75%);
  background-size: 300% 100%;
  animation: skeleton 1.3s ease infinite;
}
.loading-icon { width: 84rpx; height: 84rpx; border-radius: 24rpx; }
.loading-copy { display: flex; flex: 1; flex-direction: column; gap: 12rpx; }
.loading-copy view:first-child { width: 160rpx; height: 24rpx; border-radius: 8rpx; }
.loading-copy view:last-child { width: 210rpx; height: 18rpx; border-radius: 8rpx; }
.loading-value { width: 82rpx; height: 28rpx; border-radius: 8rpx; }
.recent-empty {
  display: flex;
  min-height: 156rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 24rpx;
  color: #9ba29b;
  font-size: 24rpx;
  background: #f7faf7;
  border-radius: 24rpx;
}
@keyframes skeleton {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}
