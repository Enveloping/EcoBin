<view class="home-page">
  <view class="topbar">
    <view class="city-pill" bindtap="onCity">
      <t-icon name="location" size="28rpx" color="#1e5528" />
      <text>{{city}}</text>
      <t-icon name="chevron-down" size="24rpx" color="#5f765f" />
    </view>
  </view>

  <view class="hero eco-card">
    <view class="hero-copy">
      <view class="hero-kicker">ECOBIN · 绿色生活</view>
      <view class="hero-title">垃圾分类</view>
      <view class="hero-sub">配合垃圾分类，争做文明市民</view>
      <view class="hero-chip">低碳每一天</view>
    </view>
    <view class="hero-art">
      <view class="sun"></view>
      <view class="tree tree-a"></view>
      <view class="tree tree-b"></view>
      <view class="bin bin-a"><text>♻</text></view>
      <view class="bin bin-b"><text>♻</text></view>
      <view class="bin bin-c"><text>♻</text></view>
    </view>
  </view>

  <view
    wx:if="{{!phoneBound}}"
    class="phone-notice eco-card"
    bindtap="onBindPhone"
  >
    <view class="phone-notice-icon">
      <t-icon name="mobile-vibrate" size="38rpx" color="#0b6b3a" />
    </view>
    <view class="phone-notice-copy">
      <text class="phone-notice-title">可选：验证手机号</text>
      <text class="phone-notice-detail">用于身份核验及后续服务，不影响当前浏览</text>
    </view>
    <text class="phone-notice-action">去验证</text>
  </view>

  <view class="feature-card eco-card">
    <view class="feature" wx:for="{{features}}" wx:key="text" data-index="{{index}}" bindtap="onFeatureTap">
      <view class="feature-icon"><t-icon name="{{item.icon}}" size="50rpx" color="#10b927" /></view>
      <text>{{item.text}}</text>
    </view>
  </view>

  <view class="stats">
    <view class="stat eco-card">
      <text class="stat-label">累计投递重量</text>
      <view><text class="stat-num">12.8</text><text class="stat-unit">kg</text></view>
      <view class="progress"><view></view></view>
      <text class="stat-note">本月累计 3.6kg</text>
    </view>
    <view class="stat eco-card">
      <text class="stat-label">账户资产</text>
      <view><text class="stat-num">26.80</text><text class="stat-unit">元</text></view>
      <view class="withdraw" bindtap="onWithdraw">去提现</view>
    </view>
  </view>

  <view class="eco-section-title">附近智能回收设备</view>
  <view class="nearby eco-card">
    <view class="nearby-head">
      <view><text class="device-name">红旗路回收站</text><text class="distance">距你 128m</text></view>
      <view class="nearby-action" bindtap="onNearby">查看全部</view>
    </view>
    <view class="map-card" bindtap="onNearby">
      <view class="road road-one"></view><view class="road road-two"></view>
      <view class="map-marker"><view></view></view>
      <view class="map-bubble">到这里回收</view>
    </view>
    <view class="category-row">
      <text wx:for="{{categories}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="scan-button" bindtap="onScan"><t-icon name="scan" size="34rpx" color="#fff" />扫码开门</view>
  </view>

  <view
    wx:if="{{showPhoneGrant}}"
    class="phone-sheet-mask"
    bindtap="onPhoneGrantClose"
    catchtouchmove="onPhoneSheetPanelTap"
  >
    <view class="phone-sheet" catchtap="onPhoneSheetPanelTap">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view class="sheet-icon">
          <t-icon name="mobile-vibrate" size="52rpx" color="#0b6b3a" />
        </view>
        <view class="sheet-title">验证手机号</view>
        <view class="sheet-close" bindtap="onPhoneGrantClose">×</view>
      </view>
      <view class="sheet-copy">
        手机号将由微信官方授权面板提供，用于当前机构身份核验和后续服务。你可以暂不授权，不影响当前浏览。
      </view>
      <button
        class="phone-grant-button"
        open-type="getPhoneNumber"
        loading="{{phoneGrantSubmitting}}"
        disabled="{{phoneGrantSubmitting}}"
        bindgetphonenumber="onGetPhoneNumber"
      >{{phoneGrantSubmitting ? '正在验证…' : '继续获取手机号'}}</button>
      <view class="sheet-skip" bindtap="onPhoneGrantClose">暂不授权</view>
      <view class="sheet-footnote">确认后将继续调用微信官方手机号能力</view>
    </view>
  </view>
</view>
