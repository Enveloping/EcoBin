<view class="home-page">
  <view class="brandbar">
    <text class="brand-name">EcoBin</text>
  </view>

  <view class="hero">
    <image
      class="hero-illustration"
      src="/assets/home/hero-recycling.png"
      mode="aspectFill"
      draggable="{{false}}"
    />
    <view class="hero-copy">
      <view class="hero-title">垃圾分类</view>
      <view class="hero-sub">扫码投递，绿色生活</view>
    </view>
  </view>

  <view
    wx:if="{{ongoingDelivery}}"
    class="ongoing-card home-card"
    bindtap="onResumeDelivery"
    hover-class="home-card--pressed"
  >
    <view class="ongoing-icon">
      <t-icon name="time" size="38rpx" color="#10a625" />
    </view>
    <view class="ongoing-copy">
      <text class="ongoing-title">{{ongoingDeliveryTitle}}</text>
      <text class="ongoing-sub">{{ongoingDeliverySubtitle}}</text>
    </view>
    <t-icon name="chevron-right" size="30rpx" color="#a3aaa3" />
  </view>

  <view class="wallet-card home-card" bindtap="onWalletTap" hover-class="home-card--pressed">
    <view class="card-icon wallet-icon">
      <t-icon name="wallet" size="52rpx" color="#10b927" />
    </view>
    <view class="wallet-value {{walletError ? 'wallet-value--error' : ''}}">
      <text class="wallet-value-text">
        {{!loggedIn ? '登录后查看' : (!walletDataAvailable ? '¥ —' : (walletLoading ? '读取中' : (walletError ? '暂时无法获取' : walletBalanceText)))}}
      </text>
    </view>
    <view class="wallet-chevron">
      <t-icon name="chevron-right" size="32rpx" color="#a3aaa3" />
    </view>
  </view>

  <view class="recent-card home-card">
    <view class="recent-head" bindtap="onOpenOrders">
      <view class="recent-title">
        <view class="card-icon card-icon--small">
          <t-icon name="time" size="40rpx" color="#10b927" />
        </view>
        <text>最近投递</text>
      </view>
      <view class="recent-more">
        <text>查看全部</text>
        <t-icon name="chevron-right" size="28rpx" color="#a3aaa3" />
      </view>
    </view>

    <view wx:if="{{!loggedIn}}" class="recent-empty" bindtap="onOpenOrders">
      <t-icon name="user" size="52rpx" color="#b4bbb4" />
      <text>登录后查看个人投递记录</text>
    </view>
    <view class="recent-loading" wx:elif="{{recentLoading}}">
      <view class="loading-icon"></view>
      <view class="loading-copy"><view></view><view></view></view>
      <view class="loading-value"></view>
    </view>
    <view
      wx:elif="{{recentDelivery}}"
      class="recent-order"
      bindtap="onOpenRecentOrder"
      hover-class="recent-order--pressed"
    >
      <view class="recent-order-icon">
        <t-icon name="{{recentDelivery.categoryIcon}}" size="38rpx" color="#10b927" />
      </view>
      <view class="recent-order-copy">
        <view class="recent-order-line">
          <text class="recent-order-name">{{recentDelivery.categoryText}}</text>
          <text class="recent-order-weight">{{recentDelivery.weightText}}</text>
        </view>
        <view class="recent-order-meta">
          <text>{{recentDelivery.timeText}}</text>
          <text class="status-{{recentDelivery.statusTone}}">{{recentDelivery.statusText}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="recent-empty">
      <t-icon name="root-list" size="52rpx" color="#b4bbb4" />
      <text>{{!deliveryOrderDataAvailable ? '投递记录服务接入中' : (recentError ? '暂时无法获取，下拉刷新重试' : '还没有投递订单')}}</text>
    </view>
  </view>

  <view
    wx:if="{{showPhoneGrant}}"
    class="phone-sheet-mask"
    bindtap="onPhoneGrantClose"
    catchtouchmove="onPhoneSheetPanelTap"
  >
    <view class="phone-sheet" catchtap="onPhoneSheetPanelTap">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view class="sheet-icon">
          <t-icon name="mobile-vibrate" size="52rpx" color="#0b6b3a" />
        </view>
        <view class="sheet-title">验证手机号</view>
        <view class="sheet-close" bindtap="onPhoneGrantClose">×</view>
      </view>
      <view class="sheet-copy">
        手机号将由微信官方授权面板提供，用于当前机构身份核验。投递、提现等功能需要先完成验证；暂不授权仍可浏览页面，但本次操作不会继续。
      </view>
      <button
        class="phone-grant-button"
        open-type="getPhoneNumber"
        loading="{{phoneGrantSubmitting}}"
        disabled="{{phoneGrantSubmitting}}"
        bindgetphonenumber="onGetPhoneNumber"
      >{{phoneGrantSubmitting ? '正在验证…' : '继续获取手机号'}}</button>
      <view class="sheet-skip" bindtap="onPhoneGrantClose">暂不授权，返回浏览</view>
      <view class="sheet-footnote">确认后将继续调用微信官方手机号能力</view>
    </view>
  </view>
</view>
