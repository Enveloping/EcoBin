.franchise-hero { display: flex; flex-direction: column; align-items: center; padding: 38rpx 20rpx; color: #fff; background: linear-gradient(135deg,#09a91f,#24ca32); border-radius: 28rpx; }.franchise-hero text:nth-child(2) { margin-top: 14rpx; font-size: 32rpx; font-weight: 750; }.franchise-hero text:nth-child(3) { margin-top: 7rpx; font-size: 22rpx; opacity: .92; }
.advantage,.form-card { margin-top: 24rpx; padding: 30rpx; }.block-title { margin-bottom: 18rpx; font-size: 27rpx; font-weight: 700; }.advantage > view:not(.block-title) { display: flex; align-items: center; gap: 18rpx; padding: 17rpx 0; border-top: 1rpx solid #edf0ed; }.adv-icon { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; background: #e8f7eb; border-radius: 50%; }.advantage > view > view:last-child { display: flex; flex-direction: column; gap: 5rpx; }.advantage > view > view:last-child text:first-child { font-size: 25rpx; font-weight: 650; }.advantage > view > view:last-child text:last-child { color: #929992; font-size: 20rpx; }
.form-card input { height: 80rpx; margin-top: 18rpx; padding: 0 24rpx; font-size: 24rpx; background: #f7f9f7; border: 2rpx solid #e1e5e1; border-radius: 20rpx; box-sizing: border-box; }.submit { margin-top: 26rpx; }
