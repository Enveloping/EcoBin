.records-page {
  min-height: 100vh;
  padding: 26rpx 28rpx calc(52rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f4f7f3;
}

.summary {
  margin-bottom: 20rpx;
  color: #7c877f;
  font-size: 22rpx;
}

.record-card,
.state-card,
.skeleton-card {
  margin-bottom: 20rpx;
  background: #fff;
  border: 1rpx solid #e7ece7;
  border-radius: 26rpx;
  box-shadow: 0 10rpx 28rpx rgba(40, 67, 43, .055);
}

.record-card {
  padding: 27rpx 26rpx 22rpx;
  transition: opacity .18s ease, transform .18s ease;
}

.record-card--pressed { opacity: .78; transform: scale(.99); }
.record-head,
.record-foot,
.record-foot view {
  display: flex;
  align-items: center;
}

.record-head { justify-content: space-between; gap: 20rpx; }
.device-title { color: #18241b; font-size: 28rpx; font-weight: 700; }
.record-time { margin-top: 7rpx; color: #8d968f; font-size: 20rpx; }

.result-tag {
  flex: 0 0 auto;
  padding: 8rpx 15rpx;
  font-size: 20rpx;
  font-weight: 650;
  border-radius: 999rpx;
}

.result-tag--normal { color: #0c9225; background: #e8f7eb; }
.result-tag--warning { color: #a66710; background: #fff1dc; }

.record-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx 22rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  background: #f7faf7;
  border-radius: 18rpx;
}

.record-grid view { display: flex; min-width: 0; flex-direction: column; }
.record-grid text:first-child { color: #929a93; font-size: 19rpx; }
.record-grid text:last-child {
  margin-top: 5rpx;
  overflow: hidden;
  color: #303b32;
  font-size: 22rpx;
  font-weight: 620;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-foot {
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 19rpx;
  color: #8d968f;
  font-size: 19rpx;
}

.record-foot view { min-width: 0; gap: 5rpx; }
.record-foot view text {
  max-width: 350rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.state-card {
  display: flex;
  min-height: 370rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 46rpx 30rpx;
  box-sizing: border-box;
}

.state-icon {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  background: #edf8ef;
  border-radius: 34rpx;
}

.state-icon--warning { background: #fff4e2; }
.state-title { margin-top: 22rpx; color: #263029; font-size: 28rpx; font-weight: 680; }
.state-copy { margin-top: 10rpx; color: #929a93; text-align: center; font-size: 22rpx; }
.state-action {
  display: flex;
  min-width: 190rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  margin-top: 26rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 650;
  background: #10b927;
  border-radius: 36rpx;
}

.skeleton-card { padding: 28rpx; }
.skeleton-line {
  width: 55%;
  height: 24rpx;
  margin-top: 18rpx;
  background: linear-gradient(90deg, #edf1ed 25%, #f8faf8 50%, #edf1ed 75%);
  background-size: 300% 100%;
  border-radius: 8rpx;
  animation: skeleton 1.3s ease infinite;
}

.skeleton-line:first-child { margin-top: 0; }
.skeleton-line--wide { width: 82%; }
.skeleton-line--short { width: 36%; }
.list-foot { padding: 22rpx 0 10rpx; color: #9ba29b; text-align: center; font-size: 21rpx; }
.list-foot--action { color: #10a625; font-weight: 620; }

@keyframes skeleton {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}
