.placeholder-page { display: flex; flex-direction: column; align-items: center; min-height: 100vh; padding: 180rpx 70rpx 0; box-sizing: border-box; text-align: center; background: #f4f7f3; }.illustration { position: relative; width: 190rpx; height: 190rpx; background: #e5f5e8; border-radius: 50%; }.leaf { position: absolute; width: 58rpx; height: 100rpx; background: #10b927; border-radius: 100% 0 100% 0; }.leaf-a { top: 36rpx; left: 54rpx; transform: rotate(-28deg); }.leaf-b { top: 57rpx; left: 94rpx; opacity: .55; transform: rotate(42deg) scale(.72); }.dot { position: absolute; right: 35rpx; bottom: 38rpx; width: 18rpx; height: 18rpx; background: #ffcd4e; border-radius: 50%; }.title { margin-top: 40rpx; font-size: 32rpx; font-weight: 750; }.description { max-width: 520rpx; margin-top: 15rpx; color: #929992; font-size: 23rpx; line-height: 1.7; }.back { margin-top: 48rpx; padding: 20rpx 60rpx; color: #fff; font-size: 25rpx; background: #10b927; border-radius: 40rpx; }
