<view class="eco-page nearby-page">
  <view class="map-overview eco-card" bindtap="onMap">
    <view class="map-line line-a"></view><view class="map-line line-b"></view>
    <view class="map-pin"><t-icon name="location" size="54rpx" color="#10b927" /></view>
    <text>地图视图</text>
    <view class="relocate" catchtap="onRelocate"><t-icon name="refresh" size="28rpx" color="#10b927" />重新定位</view>
  </view>

  <view class="device-card eco-card" wx:for="{{devices}}" wx:key="name">
    <view class="device-row">
      <view class="recycle-mark"><t-icon name="refresh" size="40rpx" color="#10b927" /></view>
      <view class="device-copy">
        <view><text class="device-name">{{item.name}}</text><text class="status {{item.tone}}">{{item.status}}</text></view>
        <text class="address">{{item.address}}</text>
      </view>
    </view>
    <view class="meta-row">
      <view class="tags"><text wx:for="{{item.categories}}" wx:for-item="category" wx:key="*this">{{category}}</text></view>
      <view class="distance"><t-icon name="location" size="24rpx" color="#9ca39c" />{{item.distance}}</view>
    </view>
    <view class="eco-primary device-action" wx:if="{{item.tone === 'free'}}" bindtap="onOpen">去这里投放</view>
  </view>
</view>
