.login {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #e8f5e9 0%, #ffffff 60%);
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo {
  font-size: 120rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 600;
  color: #0a7d34;
  margin-top: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
  margin-top: 8rpx;
}

.action {
  width: 60%;
  text-align: center;
}

.hint {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.hint.error {
  color: #e34d59;
}

.diagnostic {
  margin: -8rpx 0 24rpx;
  color: #999;
  font-size: 22rpx;
  line-height: 1.6;
  word-break: break-all;
}
