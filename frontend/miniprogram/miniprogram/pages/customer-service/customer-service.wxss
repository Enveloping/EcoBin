.service-hero { display: flex; align-items: center; gap: 26rpx; padding: 32rpx; }.headset,.contact-icon { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; background: #e8f7eb; border-radius: 50%; }.service-hero > view:last-child { display: flex; flex-direction: column; }.hero-title { font-size: 30rpx; font-weight: 700; }.hero-time { margin-top: 5rpx; color: #989f98; font-size: 22rpx; }.hero-phone { margin-top: 7rpx; color: #10b927; font-size: 32rpx; font-weight: 750; }
.contact { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding: 24rpx 28rpx; }.contact > view:first-child { display: flex; align-items: center; gap: 18rpx; }.contact-icon { width: 62rpx; height: 62rpx; }.contact > view > view:last-child { display: flex; flex-direction: column; gap: 4rpx; }.contact > view > view:last-child text:first-child { font-size: 26rpx; font-weight: 650; }.contact > view > view:last-child text:last-child { color: #9ca29c; font-size: 20rpx; }.action { padding: 12rpx 23rpx; color: #fff; font-size: 21rpx; background: #10b927; border-radius: 28rpx; }
.faq-card { margin-top: 24rpx; padding: 28rpx; }.faq-title { margin-bottom: 12rpx; font-size: 27rpx; font-weight: 700; }.faq { display: flex; align-items: center; justify-content: space-between; padding: 23rpx 0; font-size: 23rpx; border-bottom: 1rpx solid #edf0ed; }.faq:last-child { border-bottom: 0; }
