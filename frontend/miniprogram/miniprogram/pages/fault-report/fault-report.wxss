.fault-card { padding: 30rpx; }.field-label { margin: 30rpx 0 13rpx; font-size: 25rpx; font-weight: 650; }.field-label:first-child { margin-top: 0; }.field-label text { color: #9da39d; font-size: 21rpx; font-weight: 400; }
.fault-card input,.fault-card textarea { width: 100%; padding: 0 24rpx; font-size: 24rpx; background: #f7f9f7; border: 2rpx solid #e0e4e0; border-radius: 20rpx; box-sizing: border-box; }.fault-card input { height: 82rpx; }.fault-card textarea { height: 190rpx; padding-top: 22rpx; }
.fault-types { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.fault-types view { display: flex; align-items: center; justify-content: center; height: 64rpx; font-size: 23rpx; border: 2rpx solid #dfe3df; border-radius: 32rpx; }.fault-types view.selected { color: #10a425; background: #ebf8ed; border-color: #10b927; }
.upload { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; width: 144rpx; height: 144rpx; color: #aeb4ae; font-size: 20rpx; border: 2rpx dashed #bfc5bf; border-radius: 20rpx; }.preview { position: relative; width: 144rpx; height: 144rpx; }.preview image { width: 100%; height: 100%; border-radius: 20rpx; }.preview view { position: absolute; top: -13rpx; right: -13rpx; display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; color: #fff; background: #394139; border-radius: 50%; }.submit { margin-top: 26rpx; }
