<view class="operation-page">
  <view class="operation-card">
    <view class="operation-icon">
      <t-icon name="scan" size="58rpx" color="#119b2c" />
    </view>
    <view class="operation-title">{{deploymentCode ? '设备已识别' : '等待识别设备'}}</view>
    <view wx:if="{{deploymentCode}}" class="deployment-code">{{deploymentCode}}</view>
    <view class="operation-description">
      {{previewOnly
        ? '当前为界面预览，登录账号权限未改变。'
        : '清运作业接口正在接入，本页暂不发起开门或清运操作。'}}
    </view>
  </view>
</view>
