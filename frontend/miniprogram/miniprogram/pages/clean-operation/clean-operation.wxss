.operation-page {
  min-height: 100vh;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  background: #f5f7f4;
}

.operation-card {
  padding: 68rpx 38rpx;
  text-align: center;
  background: #fff;
  border: 1rpx solid #e5ebe5;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(40, 67, 43, .06);
}

.operation-icon {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  background: #edf8ef;
  border-radius: 30rpx;
}

.operation-title {
  margin-top: 28rpx;
  color: #1d2b20;
  font-size: 32rpx;
  font-weight: 700;
}

.deployment-code {
  display: inline-block;
  margin-top: 18rpx;
  padding: 12rpx 20rpx;
  color: #13772a;
  font-family: monospace;
  font-size: 22rpx;
  background: #edf8ef;
  border-radius: 12rpx;
}

.operation-description {
  max-width: 540rpx;
  margin: 22rpx auto 0;
  color: #7f8981;
  font-size: 24rpx;
  line-height: 1.7;
}
