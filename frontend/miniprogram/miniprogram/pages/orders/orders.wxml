<view class="orders-page eco-page">
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="*this" class="{{active === item ? 'active' : ''}}" data-tab="{{item}}" bindtap="onTab">{{item}}</view>
  </view>
  <view class="order-card eco-card" wx:for="{{visibleOrders}}" wx:key="id">
    <view class="order-head"><view><text class="type">{{item.type}}</text><text class="date">{{item.date}}</text></view><text class="status">{{item.status}}</text></view>
    <view class="order-body"><view><text class="title">{{item.title}}</text><text class="number">订单号：{{item.orderNo}}</text></view><text class="amount {{item.expense ? 'expense' : ''}}">{{item.amount}}</text></view>
  </view>
  <view class="empty" wx:if="{{visibleOrders.length === 0}}"><t-icon name="root-list" size="80rpx" color="#c5cbc5" /><text>暂无相关订单</text></view>
</view>
