.pickup-page { min-height: 100vh; background: #f4f7f3; }.steps { display: flex; align-items: flex-start; padding: 30rpx 42rpx 28rpx; background: #fff; }
.step { display: flex; flex-direction: column; align-items: center; gap: 9rpx; color: #9ca29c; font-size: 20rpx; white-space: nowrap; }.step > view { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; color: #fff; font-size: 23rpx; font-weight: 700; background: #d8dcd8; border-radius: 50%; }.step.active { color: #10b927; }.step.active > view { background: #10b927; }.step-line { flex: 1; height: 5rpx; margin: 25rpx 14rpx 0; background: #daddda; }.step-line.active { background: #10b927; }
.pickup-content { padding: 34rpx 26rpx; }.form-title { margin-bottom: 26rpx; font-size: 28rpx; font-weight: 700; }.category-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }.category { display: flex; align-items: center; gap: 18rpx; height: 78rpx; padding: 0 22rpx; font-size: 25rpx; font-weight: 600; background: #fff; border: 2rpx solid #e2e5e2; border-radius: 22rpx; }.category.selected { color: #0b9d20; border-color: #10b927; background: #edf9ef; }.circle { width: 27rpx; height: 27rpx; border: 3rpx solid #cbd0cb; border-radius: 50%; }.category.selected .circle { border: 8rpx solid #10b927; box-sizing: border-box; }
.next,.previous { display: flex; align-items: center; justify-content: center; height: 86rpx; margin-top: 40rpx; color: #fff; font-size: 29rpx; font-weight: 700; background: #10b927; border-radius: 23rpx; }.previous { color: #737a73; background: #eef1ee; }.buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; }.buttons > view { margin-top: 34rpx; }
.field { margin-bottom: 26rpx; }.field > text { display: block; margin: 0 4rpx 12rpx; font-size: 25rpx; font-weight: 650; }.field input,.picker { height: 84rpx; padding: 0 26rpx; font-size: 25rpx; line-height: 84rpx; background: #fff; border: 2rpx solid #e2e5e2; border-radius: 22rpx; box-sizing: border-box; }.picker.placeholder { color: #a8ada8; }
.confirm-card { padding: 30rpx; }.confirm-card > view:not(.form-title) { display: grid; grid-template-columns: 145rpx 1fr; gap: 20rpx; margin-top: 22rpx; font-size: 24rpx; }.confirm-card > view text:first-child { color: #9aa09a; }.confirm-card > view text:last-child { text-align: right; font-weight: 600; }
