<view class="management-page">
  <view class="management-hero">
    <view class="mode-label">MANAGEMENT SESSION</view>
    <view class="organization">{{organizationName}}</view>
    <view class="operator">{{displayName}}，{{previewOnly ? '当前为管理端界面预览' : '已通过工作人员绑定进入'}}</view>
  </view>
  <view class="management-card">
    <view class="card-index">01</view>
    <view class="card-title">管理入口已生效</view>
    <view class="card-copy">V-02 仅开放身份与入口验证；完整经营统计将在后续业务切片接入。</view>
    <view class="capability-list">
      <view class="capability" wx:for="{{capabilities}}" wx:key="*this">{{item}}</view>
      <view class="capability empty" wx:if="{{!capabilities.length}}">当前无展示型能力</view>
    </view>
  </view>
  <view class="account-switch" bindtap="onSwitchOrganization">
    <view>
      <view class="account-switch-title">切换机构账号</view>
      <view class="account-switch-copy">可以进入同一微信已注册的其他机构账号</view>
    </view>
    <t-icon name="chevron-right" size="34rpx" color="#9ac4a5" />
  </view>
  <view wx:if="{{entryPreviewEnabled}}" class="preview-switch">
    <view class="preview-copy">
      <view class="preview-title">测试界面预览</view>
      <view class="preview-note">{{previewNotice}}</view>
    </view>
    <button class="preview-button" bindtap="onEntryPreview">切换端</button>
  </view>
  <view class="security-note">真实权限始终以当前登录会话为准，界面预览不会改变任何权限。</view>
  <view class="logout" bindtap="onLogout">退出并重新识别入口</view>
</view>
