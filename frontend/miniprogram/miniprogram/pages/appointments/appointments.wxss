.appointment { margin-bottom: 24rpx; padding: 28rpx 30rpx; }
.appointment-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }.appointment-head > view { display: flex; align-items: center; gap: 12rpx; font-size: 28rpx; font-weight: 700; }
.status { padding: 7rpx 14rpx; font-size: 20rpx; border-radius: 20rpx; }.status.waiting { color: #0ca923; background: #e6f7e9; }.status.confirmed { color: #1686d8; background: #e4f3fd; }.status.done { color: #969c96; background: #f1f3f1; }
.detail { display: grid; grid-template-columns: 82rpx 1fr; margin-top: 14rpx; font-size: 24rpx; line-height: 1.45; }.label { color: #979d97; }
.cancel { display: flex; align-items: center; justify-content: center; height: 68rpx; margin-top: 24rpx; color: #ee4747; font-size: 24rpx; font-weight: 600; background: #fde9ee; border-radius: 20rpx; }
