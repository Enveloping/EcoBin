.withdrawal-page {
  position: relative;
  z-index: 0;
  overflow: hidden;
  min-height: 100vh;
  padding: 28rpx 28rpx calc(54rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #eef3ee;
}

.background-shape {
  position: absolute;
  z-index: 0;
  pointer-events: none;
}

.background-shape--mint {
  top: -110rpx;
  right: -190rpx;
  width: 520rpx;
  height: 380rpx;
  background: #dcecdf;
  border-radius: 58% 42% 54% 46%;
  opacity: .86;
  transform: rotate(-12deg);
}

.background-shape--cream {
  top: 590rpx;
  left: -220rpx;
  width: 540rpx;
  height: 400rpx;
  background: #f2eedc;
  border-radius: 44% 56% 48% 52%;
  opacity: .9;
  transform: rotate(11deg);
}

.create-card,
.order-card,
.state-card {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, .94);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 34rpx rgba(48, 76, 52, .06);
}

.create-card {
  padding: 26rpx 30rpx 30rpx;
  background: #f4f8f3;
}

.authorization-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  margin-bottom: 18rpx;
  padding: 22rpx 20rpx;
  background: #fff8eb;
  border: 1rpx solid #f1dfbd;
  border-radius: 20rpx;
}

.authorization-main { min-width: 0; }

.authorization-state {
  color: #774e11;
  font-size: 23rpx;
  font-weight: 720;
}

.authorization-error {
  margin-top: 7rpx;
  color: #b34b42;
  font-size: 19rpx;
  line-height: 1.5;
}

.authorization-button {
  flex: none;
  min-width: 144rpx;
  margin: 0;
  padding: 0 22rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 680;
  line-height: 62rpx;
  background: #15932c;
  border-radius: 32rpx;
}

.authorization-button::after { border: 0; }
.authorization-button[disabled] { background: #91be99; }

.amount-balance {
  display: flex;
  min-height: 28rpx;
  align-items: baseline;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 0 2rpx;
}

.amount-balance-label {
  color: #7c897e;
  font-size: 24rpx;
}

.amount-balance-value {
  color: #245430;
  font-size: 32rpx;
  font-weight: 760;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.eligibility-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  color: #a25210;
  font-size: 20rpx;
  background: #fff6e9;
  border-radius: 14rpx;
}

.inline-retry {
  flex: none;
  margin-left: 16rpx;
  color: #0d8f24;
  font-weight: 700;
}

.amount-box {
  display: flex;
  position: relative;
  align-items: baseline;
  margin-top: 8rpx;
  padding: 12rpx 0 18rpx;
  border-bottom: 2rpx solid #dfe8e0;
}

.amount-box--error {
  border-bottom-color: #d85b50;
}

.currency {
  color: #1f2a22;
  font-size: 36rpx;
  font-weight: 720;
}

.amount-input {
  height: 80rpx;
  margin-left: 12rpx;
  color: #142119;
  font-size: 64rpx;
  font-weight: 760;
  font-variant-numeric: tabular-nums;
}

.amount-error {
  margin-top: 10rpx;
  color: #bd5148;
  font-size: 20rpx;
  line-height: 1.55;
}

.submit-button--with-error {
  margin-top: 18rpx;
}

.submit-button {
  display: flex;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  background: #2b7f45;
  border: 0;
  border-radius: 44rpx;
}

.submit-button::after,
.action::after {
  border: 0;
}

.create-card button.submit-button[disabled] {
  color: #828c84;
  background: #dce2dc;
  opacity: 1;
}

.section-head {
  position: relative;
  z-index: 1;
  padding: 36rpx 4rpx 20rpx;
}

.section-title {
  color: #1f2a22;
  font-size: 30rpx;
  font-weight: 740;
}

.state-card {
  display: flex;
  min-height: 250rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 12rpx;
  color: #89928a;
  font-size: 23rpx;
}

.state-card--error { color: #b45309; }
.retry { color: #10a625; font-weight: 680; }
.empty-title { color: #28332b; font-size: 28rpx; font-weight: 700; }
.empty-copy { color: #959d96; font-size: 21rpx; }

.order-card {
  margin-bottom: 20rpx;
  padding: 27rpx 26rpx 23rpx;
}

.order-head,
.order-meta,
.order-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-amount {
  color: #1f2a22;
  font-size: 36rpx;
  font-weight: 760;
  font-variant-numeric: tabular-nums;
}

.order-no {
  margin-top: 7rpx;
  color: #9aa19b;
  font-size: 18rpx;
}

.status {
  padding: 9rpx 15rpx;
  font-size: 20rpx;
  font-weight: 650;
  border-radius: 18rpx;
}

.status--success { color: #0c8c20; background: #e9f8ec; }
.status--warning { color: #b46c05; background: #fff4df; }
.status--processing { color: #08727d; background: #e7f6f6; }
.status--failed { color: #b54b42; background: #fff0ee; }
.status--neutral { color: #707a72; background: #f0f3f0; }

.order-meta {
  margin-top: 22rpx;
  padding-top: 18rpx;
  color: #8e978f;
  font-size: 20rpx;
  border-top: 1rpx solid #edf0ed;
}

.risk-note {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  color: #a66308;
  font-size: 20rpx;
  background: #fff6e8;
  border-radius: 16rpx;
}

.order-actions {
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 21rpx;
}

.action {
  height: 66rpx;
  margin: 0;
  padding: 0 24rpx;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 66rpx;
  border-radius: 34rpx;
}

.action--plain { color: #6f7971; background: #f0f3f0; }
.action--primary { color: #fff; background: #10b927; }

.action[disabled] {
  color: rgba(255, 255, 255, .86);
  background: #7fbd89;
}

.list-footer {
  position: relative;
  z-index: 1;
  padding: 14rpx 0 30rpx;
  color: #9aa29b;
  font-size: 21rpx;
  text-align: center;
}

.continue-loading {
  color: #15942a;
  font-weight: 680;
}
