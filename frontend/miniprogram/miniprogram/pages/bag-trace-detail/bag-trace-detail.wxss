.page { min-height: 100vh; padding: 28rpx 28rpx calc(52rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #f3f7f4; }
.card, .state-card { background: #fff; border-radius: 24rpx; box-shadow: 0 10rpx 28rpx rgba(34, 66, 40, .065); }
.hero { padding: 27rpx; }
.hero-head { display: flex; align-items: center; gap: 18rpx; }
.avatar { display: flex; width: 78rpx; height: 78rpx; align-items: center; justify-content: center; flex: 0 0 auto; color: #fff; font-size: 30rpx; font-weight: 720; background: #675ac7; border-radius: 24rpx; }
.user-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 6rpx; }
.name { color: #1b271e; font-size: 29rpx; font-weight: 720; }
.phone { color: #899189; font-size: 20rpx; }
.review { padding: 8rpx 14rpx; color: #16832a; font-size: 19rpx; background: #eaf7ec; border-radius: 999rpx; }
.order-no, .time { display: block; margin-top: 17rpx; color: #7b847c; font-size: 20rpx; word-break: break-all; }
.time { margin-top: 8rpx; }
.result-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; margin-top: 20rpx; }
.result { display: flex; min-width: 0; flex-direction: column; gap: 10rpx; padding: 22rpx 15rpx; color: #838b84; font-size: 18rpx; text-align: center; }
.result .strong { overflow: hidden; color: #263229; font-size: 23rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.section { margin-top: 20rpx; padding: 27rpx; }
.section-title { color: #1b271e; font-size: 27rpx; font-weight: 710; }
.reason { display: block; margin-top: 18rpx; padding: 20rpx; color: #4d594f; font-size: 22rpx; line-height: 1.65; background: #f5f7f4; border-radius: 16rpx; white-space: pre-wrap; word-break: break-all; }
.photo-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; margin-top: 20rpx; }
.photo { display: flex; width: 100%; height: 220rpx; align-items: center; justify-content: center; flex-direction: column; gap: 9rpx; background: #edf2ed; border-radius: 18rpx; }
.photo-empty { color: #949c95; font-size: 19rpx; }
.photo-label { display: block; margin-top: 9rpx; color: #677168; font-size: 20rpx; text-align: center; }
.state-card { padding: 72rpx 30rpx; color: #69726a; font-size: 23rpx; text-align: center; }
