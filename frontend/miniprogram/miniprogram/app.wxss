page {
  --eco-green: #10b927;
  --eco-green-dark: #07951c;
  --eco-green-soft: #e8f7eb;
  --eco-ink: #202820;
  --eco-muted: #8a918a;
  --eco-line: #e9ede8;
  --eco-bg: #f4f7f3;
  min-height: 100%;
  color: var(--eco-ink);
  background: var(--eco-bg);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.phone-sheet-mask {
  position: fixed;
  z-index: 9999;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(11, 30, 18, .42);
}

.phone-sheet {
  width: 100%;
  padding: 18rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -18rpx 50rpx rgba(14, 50, 25, .14);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  background: #dbe3dc;
  border-radius: 8rpx;
}

.sheet-head {
  position: relative;
  display: flex;
  align-items: center;
  flex-direction: column;
}

.sheet-icon {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  background: #e8f7eb;
  border-radius: 28rpx;
}

.sheet-title {
  margin-top: 18rpx;
  color: #173d25;
  font-size: 34rpx;
  font-weight: 760;
}

.sheet-close {
  position: absolute;
  top: -10rpx;
  right: 0;
  width: 62rpx;
  height: 62rpx;
  color: #879088;
  font-size: 46rpx;
  line-height: 56rpx;
  text-align: center;
}

.sheet-copy {
  max-width: 620rpx;
  margin: 20rpx auto 0;
  color: #758078;
  font-size: 24rpx;
  line-height: 1.65;
  text-align: center;
}

.phone-grant-button {
  height: 92rpx;
  margin-top: 30rpx;
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 92rpx;
  background: #10a625;
  border: 0;
  border-radius: 22rpx;
}

.phone-grant-button::after { border: 0; }
.phone-grant-button[disabled] {
  color: rgba(255, 255, 255, .78);
  background: #73c780;
}

.sheet-skip {
  padding: 24rpx 0 12rpx;
  color: #667168;
  font-size: 25rpx;
  text-align: center;
}

.sheet-footnote {
  color: #a1a9a2;
  font-size: 20rpx;
  text-align: center;
}

button::after { border: 0; }

.eco-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--eco-bg);
}

.eco-card {
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 34rpx rgba(38, 72, 43, 0.07);
}

.eco-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 24rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  background: var(--eco-green);
}

.eco-section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 28rpx 4rpx 18rpx;
  font-size: 29rpx;
  font-weight: 650;
}

.eco-section-title::before {
  content: "";
  width: 8rpx;
  height: 32rpx;
  border-radius: 8rpx;
  background: var(--eco-green);
}
