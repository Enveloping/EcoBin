.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: grid;
  grid-template-columns: 1fr 132rpx 1fr;
  height: calc(150rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: transparent;
}

.tab-bar::before {
  content: "";
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  height: calc(124rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -8rpx 30rpx rgba(30, 65, 34, 0.08);
}

.tab-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  transition: opacity .16s ease, transform .16s ease;
}

.tab-item--pressed { opacity: .72; transform: scale(.97); }

.tab-label {
  color: #939a93;
  font-size: 20rpx;
  line-height: 24rpx;
}

.tab-label.active {
  color: #10b927;
  font-weight: 600;
}

.tab-active-indicator {
  width: 24rpx;
  height: 5rpx;
  margin-top: 4rpx;
  background: #10b927;
  border-radius: 5rpx;
}

.tab-scan { position: relative; }

.tab-standard {
  align-self: end;
  height: 124rpx;
  box-sizing: border-box;
}

.scan-orb {
  position: absolute;
  bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.1;
  background: #10b927;
  border: 8rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 10rpx 24rpx rgba(16, 185, 39, 0.27);
}
