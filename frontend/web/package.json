{
  "name": "ecobin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "api:types": "openapi-typescript ../../contracts/http/openapi.yaml -o src/api/generated/openapi.d.ts",
    "api:types:check": "openapi-typescript ../../contracts/http/openapi.yaml -o src/api/generated/openapi.d.ts --check",
    "test:architecture": "node --no-warnings --experimental-strip-types --test ../tests/web-architecture.test.mjs",
    "test:delivery-review": "node --no-warnings --experimental-strip-types --test ../tests/delivery-review-math.test.mjs",
    "test:e2e": "playwright test",
    "test:http-foundation": "node --no-warnings --experimental-strip-types --test ../tests/http-foundation.test.mjs",
    "test:funds-money": "node --no-warnings --experimental-strip-types --test ../tests/funds-money-input.test.mjs",
    "test:bag-label-excel": "node --no-warnings --experimental-strip-types --test ../tests/bag-label-excel.test.mjs",
    "test:operations-governance": "node --no-warnings --experimental-strip-types --test ../tests/operations-governance.test.mjs",
    "test:permission-tree": "node --no-warnings --experimental-strip-types --test ../tests/permission-tree.test.mjs",
    "test:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@ant-design/pro-components": "^2.8.2",
    "antd": "^5.22.5",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^25.9.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.9.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.4"
    }
  }
}
